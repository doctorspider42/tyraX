#include <stdio.h>

// PRIVATE kind29: sparse semantic witnesses, no clocks or per-bag IO.
namespace NightMainBatch {
struct Stat { uint32_t invocations=0;uint32_t sourceGroups=0;uint32_t sourceMembers=0;uint32_t groups=0;uint32_t members=0;uint32_t candidateGroups=0;uint32_t candidateMembers=0;uint32_t controlMainSubmits=0;uint32_t candidateMainSubmits=0;uint32_t reflectionCarriers=0;uint32_t reflectionUses=0;uint32_t fallbackGroups=0;uint32_t demotedGroups=0;uint32_t eligibilityRefused=0;uint32_t dirtyDemotions=0;uint32_t geometryCompared=0;uint32_t geometryMismatches=0;uint32_t duplicateMainSubmits=0;uint32_t verticesCompared=0;uint32_t colorBytesCompared=0; };
struct Group { uint32_t ready=0;uint32_t admitted=0;uint32_t demoted=0;uint32_t submitted=0;uint32_t first=0;uint32_t count=0;uint32_t members=0;uint32_t geometryHash=0;uint32_t infoHash=0;uint32_t lightKey=0;uint32_t spotEnabled=0; };
struct Member { uint32_t object=0;uint32_t idLo=0;uint32_t idHi=0;uint32_t group=0;uint32_t ready=0;uint32_t admitted=0;uint32_t mainOriginal=0;uint32_t mainGrouped=0;uint32_t reflectionUses=0;uint32_t count=0;uint32_t positionHash=0;uint32_t colorHash=0;uint32_t copiedPositionHash=0;uint32_t copiedColorHash=0;uint32_t infoHash=0;uint32_t lightKey=0;uint32_t spotEnabled=0; };
struct Why{uint32_t reason=0,firstDiff=~uint32_t(0),keyReady=0,keyAdmitted=0;};
inline Why why[3]{};
inline Stat stat{};inline Group group[3]{};inline Member member[11]{};
inline int pendingGroup=-1,pendingMember=-1;inline bool pendingMerged=false,pendingReflection=false;
inline void clearPending(){pendingGroup=pendingMember=-1;pendingMerged=pendingReflection=false;}
inline void accepted(){
 if(!NightAblation::collectCounters||pendingGroup<0)return;
 auto& g=group[pendingGroup];
 if(pendingReflection){if(pendingMember>=0){++member[pendingMember].reflectionUses;++stat.reflectionUses;}return;}
 if(pendingMerged){if(g.submitted)++stat.duplicateMainSubmits;g.submitted=1;++stat.candidateGroups;stat.candidateMembers+=g.members;++stat.candidateMainSubmits;
  for(unsigned j=0;j<g.members;++j){auto& x=member[g.first+j];if(x.mainOriginal||x.mainGrouped)++stat.duplicateMainSubmits;++x.mainGrouped;}
 }else if(pendingMember>=0){auto& x=member[pendingMember];if(x.mainOriginal||x.mainGrouped)++stat.duplicateMainSubmits;++x.mainOriginal;++stat.controlMainSubmits;}
}
inline void reset(){clearPending();stat=Stat{};for(auto& g:group)g=Group{};for(auto& x:member)x=Member{};for(auto& w:why)w=Why{};}
inline void emit(unsigned phase,unsigned offset,bool enabled){
 for(unsigned i=0;i<3;++i){const auto& w=why[i];printf("LOG: NIGHTMAINBATCHWHY phase=%u offset=%u enabled=%u group=%u reason=%u firstDiff=%u keyReady=%u keyAdmitted=%u\n",phase,offset,unsigned(enabled),i,w.reason,w.firstDiff,w.keyReady,w.keyAdmitted);}
 for(const auto& g:group){if(g.admitted){++stat.groups;stat.members+=g.members;}else ++stat.fallbackGroups;}
 printf("LOG: NIGHTMAINBATCH phase=%u offset=%u enabled=%u invocations=%u sourceGroups=%u sourceMembers=%u groups=%u members=%u candidateGroups=%u candidateMembers=%u controlMainSubmits=%u candidateMainSubmits=%u reflectionCarriers=%u reflectionUses=%u fallbackGroups=%u demotedGroups=%u eligibilityRefused=%u dirtyDemotions=%u geometryCompared=%u geometryMismatches=%u duplicateMainSubmits=%u verticesCompared=%u colorBytesCompared=%u\n",phase,offset,unsigned(enabled),stat.invocations,stat.sourceGroups,stat.sourceMembers,stat.groups,stat.members,stat.candidateGroups,stat.candidateMembers,stat.controlMainSubmits,stat.candidateMainSubmits,stat.reflectionCarriers,stat.reflectionUses,stat.fallbackGroups,stat.demotedGroups,stat.eligibilityRefused,stat.dirtyDemotions,stat.geometryCompared,stat.geometryMismatches,stat.duplicateMainSubmits,stat.verticesCompared,stat.colorBytesCompared);
 for(unsigned i=0;i<3;++i){const auto& g=group[i];printf("LOG: NIGHTMAINBATCHGROUP phase=%u offset=%u enabled=%u group=%u ready=%u admitted=%u demoted=%u submitted=%u first=%u count=%u members=%u geometryHash=%u infoHash=%u lightKey=%u spotEnabled=%u\n",phase,offset,unsigned(enabled),i,g.ready,g.admitted,g.demoted,g.submitted,g.first,g.count,g.members,g.geometryHash,g.infoHash,g.lightKey,g.spotEnabled);}
 for(unsigned i=0;i<11;++i){const auto& x=member[i];printf("LOG: NIGHTMAINBATCHMEMBER phase=%u offset=%u enabled=%u ordinal=%u object=%u idLo=%u idHi=%u group=%u ready=%u admitted=%u mainOriginal=%u mainGrouped=%u reflectionUses=%u count=%u positionHash=%u colorHash=%u copiedPositionHash=%u copiedColorHash=%u infoHash=%u lightKey=%u spotEnabled=%u\n",phase,offset,unsigned(enabled),i,x.object,x.idLo,x.idHi,x.group,x.ready,x.admitted,x.mainOriginal,x.mainGrouped,x.reflectionUses,x.count,x.positionHash,x.colorHash,x.copiedPositionHash,x.copiedColorHash,x.infoHash,x.lightKey,x.spotEnabled);}
}
