diff --git a/src/Alias.cpp b/src/Alias.cpp
index a29122a..f075e7e 100644
--- a/src/Alias.cpp
+++ b/src/Alias.cpp
@@ -35,6 +35,24 @@ namespace
 
 	bool rangesOverlap( const Alias::Range& a, const Alias::Range& b )
 	{
+		// Ranges that merely TOUCH - one ends on the very line the other
+		// begins - do not conflict, so the two aliases may share a register.
+		// A live range ends at its last READ and begins at a WRITE (openvcl
+		// rejects a read-before-write outright), and a VU instruction reads its
+		// sources before it writes its destination, so on that one line the old
+		// value has already been consumed. Counting the touch as a conflict
+		// costs a register per touching pair and is what made the
+		// directional-light clip/cull programs fail to allocate: measured peak
+		// pressure in stapip_clip_d is 32 simultaneous aliases counting touches,
+		// 31 without - against 31 allocatable VF registers.
+		//
+		// This is the ONLY caller-visible rule change; Alias::intersects (the
+		// register-sharing test in RegisterAllocator) is this function's only
+		// caller, so the relaxation cannot leak into the live-range extension
+		// passes, which keep their own inclusive test in hasRangeOverlapping.
+		if( a.m_stop == b.m_start || b.m_stop == a.m_start )
+			return false;
+
 		return !(a.m_stop < b.m_start || b.m_stop < a.m_start);
 	}
 }
