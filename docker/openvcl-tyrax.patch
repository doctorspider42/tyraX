+
 Alias* RegisterAllocator::obtainAlias( Alias::Type type )
 {
 	Alias* alias = new Alias( type );
diff --git a/src/RegisterAllocator.h b/src/RegisterAllocator.h
index 738fca5..7c783cd 100644
--- a/src/RegisterAllocator.h
+++ b/src/RegisterAllocator.h
@@ -24,6 +24,7 @@
 #endif
 
 #include <map>
+#include <set>
 #include <vector>
 #include <sstream>
 
