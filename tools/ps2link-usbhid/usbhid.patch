diff --git a/ee/Makefile b/ee/Makefile
index 2eb1e7e..444074e 100644
--- a/ee/Makefile
+++ b/ee/Makefile
@@ -9,6 +9,9 @@ EE_LIBS += -lpatches -ldebug
 IRX_FILES += ioptrap.irx ps2dev9.irx poweroff.irx
 IRX_FILES += ps2ip.irx netman.irx smap.irx udptty.irx
 IRX_FILES += ps2link.irx
+# TyraX: bake in the USB HID stack (usbd + keyboard + mouse). These ship
+# prebuilt in $(PS2SDK)/iop/irx/ and are picked up by the generic %_irx.c rule.
+IRX_FILES += usbd.irx ps2kbd.irx ps2mouse.irx
 EE_OBJS += $(IRX_FILES:.irx=_irx.o) ps2ip_nm_irx.o
 
 # Compile with -Werror
diff --git a/ee/irx_variables.h b/ee/irx_variables.h
index 0cf38a6..14cbb38 100644
--- a/ee/irx_variables.h
+++ b/ee/irx_variables.h
@@ -34,4 +34,16 @@ extern unsigned int size_smap_irx;
 extern unsigned char udptty_irx[];
 extern unsigned int size_udptty_irx;
 
+/* TyraX: USB HID stack baked into ps2link so a network deploy keeps a
+ * keyboard + mouse. usbd MUST be resident before ps2kbd/ps2mouse (they
+ * import its symbols), so load them in this order. */
+extern unsigned char usbd_irx[];
+extern unsigned int size_usbd_irx;
+
+extern unsigned char ps2kbd_irx[];
+extern unsigned int size_ps2kbd_irx;
+
+extern unsigned char ps2mouse_irx[];
+extern unsigned int size_ps2mouse_irx;
+
 #endif /* IRX_VARIABLES_H */
diff --git a/ee/ps2link.c b/ee/ps2link.c
index d566140..d5afa34 100644
--- a/ee/ps2link.c
+++ b/ee/ps2link.c
@@ -176,13 +176,28 @@ static void loadModules(void)
     dbgscr_printf("Exec ps2link module. (%x,%d) ", (unsigned int)ps2link_irx, size_ps2link_irx);
     SifExecModuleBuffer(ps2link_irx, size_ps2link_irx, 0, NULL, &ret);
     dbgscr_printf("[%d] returned\n", ret);
+
+    /* TyraX: USB HID stack. usbd first (ps2kbd/ps2mouse import it), so a
+     * game deployed over this ps2link can reuse the resident drivers and get
+     * a keyboard AND mouse without loading its own usbd. */
+    dbgscr_printf("Exec usbd module. (%x,%d) ", (unsigned int)usbd_irx, size_usbd_irx);
+    SifExecModuleBuffer(usbd_irx, size_usbd_irx, 0, NULL, &ret);
+    dbgscr_printf("[%d] returned\n", ret);
+    dbgscr_printf("Exec ps2kbd module. (%x,%d) ", (unsigned int)ps2kbd_irx, size_ps2kbd_irx);
+    SifExecModuleBuffer(ps2kbd_irx, size_ps2kbd_irx, 0, NULL, &ret);
+    dbgscr_printf("[%d] returned\n", ret);
+    dbgscr_printf("Exec ps2mouse module. (%x,%d) ", (unsigned int)ps2mouse_irx, size_ps2mouse_irx);
+    SifExecModuleBuffer(ps2mouse_irx, size_ps2mouse_irx, 0, NULL, &ret);
+    dbgscr_printf("[%d] returned\n", ret);
+
     dbgscr_printf("All modules loaded on IOP.\n");
 }
 
