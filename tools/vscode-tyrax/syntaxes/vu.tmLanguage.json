{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TyraX VU1 microprogram",
  "scopeName": "source.tyrax-vu",
  "patterns": [
    { "include": "#comment" },
    { "include": "#preprocessor" },
    { "include": "#vclMarker" },
    { "include": "#directive" },
    { "include": "#label" },
    { "include": "#instruction" },
    { "include": "#register" },
    { "include": "#number" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        { "name": "comment.line.semicolon.tyrax-vu", "match": ";.*$" },
        { "name": "comment.line.double-slash.tyrax-vu", "match": "//.*$" }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.include.tyrax-vu",
          "match": "^\\s*(#include)\\s+(\"[^\"]*\")",
          "captures": {
            "1": { "name": "keyword.control.directive.include.tyrax-vu" },
            "2": { "name": "string.quoted.double.tyrax-vu" }
          }
        },
        {
          "name": "meta.preprocessor.define.tyrax-vu",
          "match": "^\\s*(#define)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.directive.define.tyrax-vu" },
            "2": { "name": "entity.name.constant.tyrax-vu" }
          }
        },
        {
          "name": "meta.preprocessor.macro.tyrax-vu",
          "match": "^\\s*(#macro)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.directive.tyrax-vu" },
            "2": { "name": "entity.name.function.macro.tyrax-vu" }
          }
        },
        {
          "match": "^\\s*(#endmacro|#endvuprog)\\b",
          "captures": { "1": { "name": "keyword.control.directive.tyrax-vu" } }
        },
        {
          "match": "^\\s*(#vuprog)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.directive.tyrax-vu" },
            "2": { "name": "entity.name.function.tyrax-vu" }
          }
        },
        {
          "name": "meta.function-call.macro.tyrax-vu",
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*(\\{)",
          "captures": { "1": { "name": "entity.name.function.macro.tyrax-vu" } }
        }
      ]
    },
    "vclMarker": {
      "name": "keyword.control.vcl.tyrax-vu",
      "match": "^\\s*--(enter|endenter|exit|endexit|cont|barrier|blockstart|blockend)\\b"
    },
    "directive": {
      "name": "keyword.other.directive.tyrax-vu",
      "match": "^\\s*\\.(syntax|name|vu|init_vf_all|init_vi_all|init_vf|init_vi|global|align)\\b"
    },
    "label": {
      "name": "entity.name.label.tyrax-vu",
      "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*:"
    },
    "instruction": {
      "patterns": [
        {
          "comment": "Float and load/store ops carry a destination-field mask.",
          "match": "(?i)\\b(nop|abs|add|adda|addi|addq|sub|suba|subi|subq|mul|mula|muli|mulq|madd|madda|msub|msuba|mini|minii|max|maxi|move|mr32|ftoi0|ftoi4|ftoi12|ftoi15|itof0|itof4|itof12|itof15|clip|clipw|lq|lqd|lqi|sq|sqd|sqi|opmula|opmsub)(\\.[xyzw]{1,4})?\\b",
          "captures": {
            "1": { "name": "keyword.operator.vu.tyrax-vu" },
            "2": { "name": "support.type.mask.tyrax-vu" }
          }
        },
        {
          "comment": "Integer, flag, branch and transfer ops.",
          "match": "(?i)\\b(div|rsqrt|sqrt|loi|mtir|mfir|movei|ilw|isw|ilwr|iswr|iadd|iaddi|iaddiu|isub|isubiu|iand|ior|b|bal|jr|jalr|ibeq|ibne|iblez|ibgez|ibgtz|ibltz|fcand|fcor|fceq|fcset|fcget|fmand|fmor|fmeq|fsand|fsor|fseq|fsset|xtop|xitop|xgkick|waitq|waitp|rinit|rget|rnext|rxor|eleng|erleng|esqrt|ersqrt|ediv|erdiv|eatan|esin|eexp|elengv|xgkickw)\\b",
          "captures": { "1": { "name": "keyword.operator.vu.tyrax-vu" } }
        }
      ]
    },
    "register": {
      "patterns": [
        {
          "comment": "Hardwired registers: vf00 is (0,0,0,1) and vi00 is 0.",
          "name": "support.constant.register.hardwired.tyrax-vu",
          "match": "(?i)\\b(vf00|vi00|VI01)\\b"
        },
        {
          "name": "variable.language.register.tyrax-vu",
          "match": "(?i)\\b(vf[0-2][0-9]|vf3[01]|vi0[1-9]|vi1[0-5]|acc|[QqIiRr])\\b(?![A-Za-z0-9_])"
        },
        {
          "comment": "Broadcast field or VCL register-array index.",
          "name": "support.type.field.tyrax-vu",
          "match": "\\[(?:[xyzw]|[0-9]+)\\]"
        }
      ]
    },
    "number": {
      "patterns": [
        { "name": "constant.numeric.hex.tyrax-vu", "match": "\\b0[xX][0-9a-fA-F]+\\b" },
        { "name": "constant.numeric.tyrax-vu", "match": "\\b-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?[fF]?\\b" }
      ]
    }
  }
}
