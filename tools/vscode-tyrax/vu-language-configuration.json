{
  "comments": { "lineComment": ";" },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(#vuprog|#macro)\\b.*$",
    "decreaseIndentPattern": "^\\s*(#endvuprog|#endmacro)\\b.*$"
  }
}
