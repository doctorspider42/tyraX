{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tyra Flow Node",
  "scopeName": "source.tyra-flownode",
  "patterns": [
    { "include": "#body" },
    { "include": "#comment" },
    { "include": "#header" }
  ],
  "repository": {
    "comment": {
      "match": "^\\s*#.*$",
      "name": "comment.line.number-sign.tyra-flownode"
    },
    "header": {
      "patterns": [
        {
          "comment": "string = none|text|object",
          "match": "^\\s*(string)\\s*(=)\\s*(none|text|object)?(.*)$",
          "captures": {
            "1": { "name": "keyword.control.header.tyra-flownode" },
            "2": { "name": "punctuation.separator.key-value.tyra-flownode" },
            "3": { "name": "constant.language.tyra-flownode" },
            "4": { "name": "string.unquoted.value.tyra-flownode" }
          }
        },
        {
          "comment": "exec_out = true|false",
          "match": "^\\s*(exec_out)\\s*(=)\\s*(true|false)?(.*)$",
          "captures": {
            "1": { "name": "keyword.control.header.tyra-flownode" },
            "2": { "name": "punctuation.separator.key-value.tyra-flownode" },
            "3": { "name": "constant.language.tyra-flownode" },
            "4": { "name": "string.unquoted.value.tyra-flownode" }
          }
        },
        {
          "comment": "in / out = object position bool text (space separated pins)",
          "begin": "^\\s*(in|out)\\s*(=)",
          "beginCaptures": {
            "1": { "name": "keyword.control.header.tyra-flownode" },
            "2": { "name": "punctuation.separator.key-value.tyra-flownode" }
          },
          "end": "$",
          "patterns": [
            {
              "match": "\\b(object|position|bool|text)\\b",
              "name": "constant.language.pin.tyra-flownode"
            },
            {
              "match": "[^\\s]+",
              "name": "invalid.illegal.pin.tyra-flownode"
            }
          ]
        },
        {
          "comment": "num0..num3 = Label",
          "match": "^\\s*(num[0-3])\\s*(=)\\s*(.*)$",
          "captures": {
            "1": { "name": "keyword.control.header.tyra-flownode" },
            "2": { "name": "punctuation.separator.key-value.tyra-flownode" },
            "3": { "name": "string.unquoted.value.tyra-flownode" }
          }
        },
        {
          "comment": "known scalar keys",
          "match": "^\\s*(title|category|call)\\s*(=)\\s*(.*)$",
          "captures": {
            "1": { "name": "keyword.control.header.tyra-flownode" },
            "2": { "name": "punctuation.separator.key-value.tyra-flownode" },
            "3": { "name": "string.unquoted.value.tyra-flownode" }
          }
        },
        {
          "comment": "unknown key: still colour key/=/value, flag the key",
          "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(=)\\s*(.*)$",
          "captures": {
            "1": { "name": "invalid.deprecated.unknown-key.tyra-flownode" },
            "2": { "name": "punctuation.separator.key-value.tyra-flownode" },
            "3": { "name": "string.unquoted.value.tyra-flownode" }
          }
        }
      ]
    },
    "placeholder": {
      "match": "\\{(obj|self|str|num[0-3]|int[0-3])\\}",
      "name": "variable.language.placeholder.tyra-flownode"
    },
    "body": {
      "comment": "Everything after the --- line is C++ emitted verbatim into flow_graph.gen.cpp; run source.cpp over it and overlay {placeholder} tokens. The region never ends (runs to EOF).",
      "begin": "^(---)\\s*$",
      "beginCaptures": {
        "1": { "name": "punctuation.section.separator.tyra-flownode" }
      },
      "end": "(?!)",
      "contentName": "meta.embedded.block.cpp",
      "patterns": [
        { "include": "#placeholder" },
        { "include": "source.cpp" }
      ]
    }
  }
}
