         "Coprocessor unusable", "Arithmetic overflow", "Trap"};
 
+/* TyraX: `cause & 0x7c` yields exception codes 0..31 but codeTxt only names
+ * 14 of them, and both handlers below fed the raw index to a %s. Anything
+ * from 14 up read past the table and printed whatever followed it as a
+ * string - a second fault while reporting the first, which is how a crash
+ * turned into a console that just sat there. */
+static const char *exceptionName(int code)
+{
+    int index = code >> 2;
+
+    if ((index < 0) || (index >= (int)(sizeof(codeTxt) / sizeof(codeTxt[0])))) {
+        return "Unknown";
+    }
+    return codeTxt[index];
+}
+
