engine-patches/** text eol=lf

# Vendored Tyra engine is a Unix build (make + vclpp). vclpp chokes on CRLF
# ("Preprocessor directive inside macro block: '#endmacro'"), so keep LF
# regardless of the checkout's core.autocrlf setting.
vendor/tyra/** text=auto eol=lf

# Prebuilt audsrv artifacts (built from the vendored source next to them -
# see vendor/tyra/audsrv/README.md) - never treat as text.
vendor/tyra/audsrv/bin/*.irx binary
vendor/tyra/audsrv/bin/*.a binary

# The editor always writes LF, and generated projects are built in a Linux
# Docker container. Pin them to LF so a checkout with core.autocrlf=true does
# not flag every project re-save as "modified" (empty diff, only the
# "LF will be replaced by CRLF" warning). text=auto keeps binaries (glb/wav/png)
# untouched. Also pin the editor's own file formats wherever they live.
examples/** text=auto eol=lf
*.tyra text eol=lf
*.heights text eol=lf
*.flownode text eol=lf

# The TyraX ps2link patch is applied to a Unix (Linux-container) checkout of
# ps2link; a CRLF patch fails `git apply`. Keep it (and the tool sources) LF.
tools/ps2link/** text=auto eol=lf

# Same reason, same failure: docker/Dockerfile COPYs this one into the openvcl
# build stage and runs `git apply` on it inside Linux. It is LF today only
# because it is written by a script that normalises; a fresh clone on Windows
# would check it out CRLF and the image build would stop there.
docker/openvcl-tyrax.patch text eol=lf
