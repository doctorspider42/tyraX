# The neural upscaler's network and its provenance sidecar. The `.net` is 500
# bytes of floats and must never be line-ending-normalised; the `.meta` is text
# the TRAINER writes with LF, and the check that guards the shipped default is
# "re-run the command recorded inside it and diff", so a checkout that turned it
# into CRLF would make that diff fail forever on Windows and nowhere else.
*.net binary
*.net.meta text eol=lf

# The TyraX ps2link patch is applied to a Unix (Linux-container) checkout of
# ps2link; a CRLF patch fails `git apply`. Keep it (and the tool sources) LF.
tools/ps2link/** text=auto eol=lf

# Same reason, same failure: docker/Dockerfile COPYs this one into the openvcl
# build stage and runs `git apply` on it inside Linux. It is LF today only
# because it is written by a script that normalises; a fresh clone on Windows
# would check it out CRLF and the image build would stop there.
docker/openvcl-tyrax.patch text eol=lf

# Native PS2 builds execute these sources and scripts on Linux or in WSL.
vendor/openvcl/** text=auto eol=lf
vendor/vclpp/** text=auto eol=lf
tools/toolchain/** text=auto eol=lf

