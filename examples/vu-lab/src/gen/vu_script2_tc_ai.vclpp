; Generated by TyraX. Do not edit - regenerated on every build
; from the stage list in Tools > VU Programs (docs/vu-authoring.md).
;
; Vertex snap - Textured
; Installed over the engine's StaPipAsIsTextureColor slot, so it
; draws EVERY mesh of that material class. A mesh whose four
; parameters are zero is rendered bit-identically to the engine's
; own program - that is the contract --vu-check enforces.

.syntax new
.name TyraXScript2TCAI
.vu
.init_vf_all
.init_vi_all

--enter
--endenter

#vuprog TyraXScript2TCAI

    lq         gifSetTag, 19(vi00)  ; VU1_SET_GIFTAG_ADDR
    lq         singleColor, 7(vi00)  ; VU1_SINGLE_COLOR_ADDR
    ilw.x      singleColorEnabled, 8(vi00)  ; VU1_OPTIONS_ADDR.x = single colour flag
    lq         lodGifTag, 9(vi00)  ; VU1_LOD_ADDR
    lq         testsTag, 10(vi00)  ; VU1_Z_TESTS_ADDR
    lq         texBufferClutGifTag, 11(vi00)  ; VU1_CLUT_ADDR
    lq         alphaGifTag, 21(vi00)  ; VU1_ALPHA_ADDR - per-mesh GS blend equation, in-band
    lq         fogParams, 8(vi00)  ; VU1_OPTIONS_ADDR.zw = GS hardware fog
    lq         vuParams, 15(vi00)  ; VU1_CUSTOM_PARAMS_ADDR - the mesh's four numbers (the lights-colour area; a bag carrying these has no lighting)
    lq         vuTime, 16(vi00)  ; VU1_CUSTOM_TIME_ADDR - (time, sin time, cos time, 1.0)
    add.xyz    vuOne, vf00, vf00[w]  ; 1.0 in every field
    mul.w      vuOne, vf00, vf00[w]
begin:
    xtop       buffer
    lq.xyz     scale, 0(buffer)  ; LoadTyraBufferTags
    lq         primTag, 1(buffer)
    iaddiu     vertexData, buffer, 2  ; VU1_STAPIP_VERT_DATA_ADDR
    ilw.w      vertexCount, 0(buffer)
    iadd       stqData, vertexData, vertexCount
    iadd       colorData, stqData, vertexCount
    iblez      singleColorEnabled, setDestAddrMultiColor
    iadd       kickAddress, stqData, vertexCount
    b          setDestAddr
setDestAddrMultiColor:
    iadd       kickAddress, colorData, vertexCount
setDestAddr:
    iaddiu     destAddress, kickAddress, 0
    sq         gifSetTag, 0(destAddress)  ; GIF tag block
    sq         testsTag, 1(destAddress)
    sq         gifSetTag, 2(destAddress)
    sq         lodGifTag, 3(destAddress)
    sq         gifSetTag, 4(destAddress)
    sq         texBufferClutGifTag, 5(destAddress)
    sq         gifSetTag, 6(destAddress)
    sq         alphaGifTag, 7(destAddress)
    sq         primTag, 8(destAddress)
    iaddiu     destAddress, destAddress, 9
    iadd       vertexCounter, buffer, vertexCount
vertexLoop:
    iblez      singleColorEnabled, multiColor
    add        color1, vf00, singleColor
    add        color2, vf00, singleColor
    add        color3, vf00, singleColor
    b          processing
multiColor:
    lq         color1, 0(colorData)
    lq         color2, 1(colorData)
    lq         color3, 2(colorData)
processing:
    lq         vertex1, 0(vertexData)  ; W carries the clip-space distance (fog)
    lq         stq1, 0(stqData)
    lq         vertex2, 1(vertexData)
    lq         stq2, 1(stqData)
    lq         vertex3, 2(vertexData)
    lq         stq3, 2(stqData)
    loi        0  ; constants
    add.x      k0, vf00, i
    loi        160
    add.y      k0, vf00, i
    loi        0.00625000009
    add.z      k0, vf00, i
    loi        0
    mul.w      k0, vf00, i
    mula.xyz   acc, scale, vf00[w]  ; ScaleVertexToGSFormat
    madd.xyz   vertex1, vertex1, scale
    ftoi4.xyz  vertex1, vertex1
    div        q, vf00[w], vertex1[w]
    mul        outputStq1, stq1, q  ; PerformTexturePerspectiveCorrection
    loi        255  ; FixColor: clamp to 0..255
    mini.xyz   color1, color1, i
    max.xyz    color1, color1, vf00[x]
    ftoi0      color1, color1
    mula.xyz   acc, scale, vf00[w]  ; ScaleVertexToGSFormat
    madd.xyz   vertex2, vertex2, scale
    ftoi4.xyz  vertex2, vertex2
    div        q, vf00[w], vertex2[w]
    mul        outputStq2, stq2, q  ; PerformTexturePerspectiveCorrection
    loi        255  ; FixColor: clamp to 0..255
    mini.xyz   color2, color2, i
    max.xyz    color2, color2, vf00[x]
    ftoi0      color2, color2
    mula.xyz   acc, scale, vf00[w]  ; ScaleVertexToGSFormat
    madd.xyz   vertex3, vertex3, scale
    ftoi4.xyz  vertex3, vertex3
    div        q, vf00[w], vertex3[w]
    mul        outputStq3, stq3, q  ; PerformTexturePerspectiveCorrection
    loi        255  ; FixColor: clamp to 0..255
    mini.xyz   color3, color3, i
    max.xyz    color3, color3, vf00[x]
    ftoi0      color3, color3
    add.x      fogAccum, vf00, vertex1[w]  ; CalculateTyraFog
    mul.x      fogAccum, fogAccum, fogParams[z]
    add.x      fogAccum, fogAccum, fogParams[w]
    loi        255
    mini.x     fogAccum, fogAccum, i
    max.x      fogAccum, fogAccum, vf00[x]
    ftoi4.x    fogAccum, fogAccum
    mtir       fogInt, fogAccum[x]
    isw.w      fogInt, 2(destAddress)
    add.x      fogAccum, vf00, vertex2[w]  ; CalculateTyraFog
    mul.x      fogAccum, fogAccum, fogParams[z]
    add.x      fogAccum, fogAccum, fogParams[w]
    loi        255
    mini.x     fogAccum, fogAccum, i
    max.x      fogAccum, fogAccum, vf00[x]
    ftoi4.x    fogAccum, fogAccum
    mtir       fogInt, fogAccum[x]
    isw.w      fogInt, 5(destAddress)
    add.x      fogAccum, vf00, vertex3[w]  ; CalculateTyraFog
    mul.x      fogAccum, fogAccum, fogParams[z]
    add.x      fogAccum, fogAccum, fogParams[w]
    loi        255
    mini.x     fogAccum, fogAccum, i
    max.x      fogAccum, fogAccum, vf00[x]
    ftoi4.x    fogAccum, fogAccum
    mtir       fogInt, fogAccum[x]
    isw.w      fogInt, 8(destAddress)
    sq         outputStq1, 0(destAddress)
    sq         color1, 1(destAddress)
    sq.xyz     vertex1, 2(destAddress)
    sq         outputStq2, 3(destAddress)
    sq         color2, 4(destAddress)
    sq.xyz     vertex2, 5(destAddress)
    sq         outputStq3, 6(destAddress)
    sq         color3, 7(destAddress)
    sq.xyz     vertex3, 8(destAddress)
    iaddiu     vertexData, vertexData, 3
    iaddiu     stqData, stqData, 3
    iaddiu     colorData, colorData, 3
    iaddiu     destAddress, destAddress, 9
    iaddi      vertexCounter, vertexCounter, -3  ; decrement the loop counter
    ibne       vertexCounter, buffer, vertexLoop
    xgkick     kickAddress  ; dispatch to the GS rasterizer

--barrier
--cont

    b          begin

#endvuprog

--exit
--endexit
