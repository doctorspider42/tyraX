; Generated by TyraX. Do not edit - regenerated on every build
; from the stage list in Tools > VU Programs (docs/vu-authoring.md).
;
; Palette - Textured
; Installed over the engine's StaPipClipTextureColor slot, so it
; draws EVERY mesh of that material class. A mesh whose four
; parameters are zero is rendered bit-identically to the engine's
; own program - that is the contract --vu-check enforces.

.syntax new
.name TyraXScript1TCCL
.vu
.init_vf_all
.init_vi_all

--enter
--endenter

#vuprog TyraXScript1TCCL

    fcset      0x000000  ; ResetClipFlags
    lq         gifSetTag, 19(vi00)  ; VU1_SET_GIFTAG_ADDR
    lq         mvp[0], 0(vi00)  ; MatrixLoad - VU1_MVP_MATRIX_ADDR
    lq         mvp[1], 1(vi00)
    lq         mvp[2], 2(vi00)
    lq         mvp[3], 3(vi00)
    lq         singleColor, 7(vi00)  ; VU1_SINGLE_COLOR_ADDR
    lq         lodGifTag, 9(vi00)  ; VU1_LOD_ADDR
    lq         testsTag, 10(vi00)  ; VU1_Z_TESTS_ADDR
    lq         texBufferClutGifTag, 11(vi00)  ; VU1_CLUT_ADDR
    lq         alphaGifTag, 21(vi00)  ; VU1_ALPHA_ADDR - per-mesh GS blend equation, in-band
    lq         fogParams, 8(vi00)  ; VU1_OPTIONS_ADDR.zw = GS hardware fog
    lq         spotPos, 12(vi00)  ; LoadTyraSpotLight - reuses the dir-lights slots, free in the colour programs
    lq         spotDirV, 13(vi00)
    lq         spotColV, 14(vi00)
    lq         cvec, 20(vi00)  ; VU1_CLIP_CONSTS_ADDR
    move       sjudge, cvec
    lq         vuParams, 15(vi00)  ; VU1_CUSTOM_PARAMS_ADDR - the mesh's four numbers (the lights-colour area; a bag carrying these has no lighting)
    lq         vuTime, 16(vi00)  ; VU1_CUSTOM_TIME_ADDR - (time, sin time, cos time, 1.0)
    add.xyz    vuOne, vf00, vf00[w]  ; 1.0 in every field
    mul.w      vuOne, vf00, vf00[w]
begin:
    xtop       buffer
    lq.xyz     scale, 0(buffer)  ; LoadTyraBufferTags
    lq         primTag, 1(buffer)
    iaddiu     vertexData, buffer, 2  ; VU1_STAPIP_VERT_DATA_ADDR
    ilw.w      vertexCount, 0(buffer)
    iadd       stqData, vertexData, vertexCount
    iadd       colorData, stqData, vertexCount
    ilw.x      sceFlag, 8(vi00)  ; VU1_OPTIONS_ADDR.x = single colour flag
    iblez      sceFlag, setDestAddrMultiColor
    iadd       destAddress, stqData, vertexCount
    b          setDestAddr
setDestAddrMultiColor:
    iadd       destAddress, colorData, vertexCount
setDestAddr:
    sq         gifSetTag, 0(destAddress)  ; GIF tag block
    sq         testsTag, 1(destAddress)
    sq         gifSetTag, 2(destAddress)
    sq         lodGifTag, 3(destAddress)
    sq         gifSetTag, 4(destAddress)
    sq         texBufferClutGifTag, 5(destAddress)
    sq         gifSetTag, 6(destAddress)
    sq         alphaGifTag, 7(destAddress)
    sq         primTag, 8(destAddress)
    iaddiu     destAddress, destAddress, 9
    iaddiu     outCount, vi00, 0
    iadd       vertexCounter, vi00, vertexCount
triLoop:
    ilw.x      sceFlag, 8(vi00)
    iblez      sceFlag, multiColor
    add        color1, vf00, singleColor
    add        color2, vf00, singleColor
    add        color3, vf00, singleColor
    b          processing
multiColor:
    lq         color1, 0(colorData)
    lq         color2, 1(colorData)
    lq         color3, 2(colorData)
processing:
    lq         vertex1, 0(vertexData)  ; object space - the MVP multiply is below
    lq         vertex2, 1(vertexData)
    lq         vertex3, 2(vertexData)
    lq         stq1, 0(stqData)
    lq         stq2, 1(stqData)
    lq         stq3, 2(stqData)
    loi        0.00117254897  ; constants
    add.x      k0, vf00, i
    loi        0.00230196072
    add.y      k0, vf00, i
    loi        0.000447058817
    add.z      k0, vf00, i
    loi        0
    mul.w      k0, vf00, i
    loi        40  ; constants
    add.x      k1, vf00, i
    loi        30
    add.y      k1, vf00, i
    loi        70
    add.z      k1, vf00, i
    loi        0
    mul.w      k1, vf00, i
    loi        215  ; constants
    add.x      k2, vf00, i
    loi        190
    add.y      k2, vf00, i
    loi        60
    add.z      k2, vf00, i
    loi        0
    mul.w      k2, vf00, i
    sub.xyz    spotD, vertex1, spotPos  ; CalculateTyraSpotLight
    mul.xyz    spotSq, spotD, spotD
    add.x      spotDist, spotSq, spotSq[y]
    add.x      spotDist, spotDist, spotSq[z]
    mul.xyz    spotTm, spotD, spotDirV
    add.x      spotT, spotTm, spotTm[y]
    add.x      spotT, spotT, spotTm[z]
    max.x      spotT, spotT, vf00[x]
    mul.x      spotT, spotT, spotT
    mul.x      spotC, spotDist, spotDirV[w]
    sub.x      spotC, spotT, spotC
    mul.x      spotC, spotC, spotColV[w]
    mini.x     spotC, spotC, vf00[w]
    max.x      spotC, spotC, vf00[x]
    add.x      acc, vf00, vf00[w]
    msub.x     spotA, spotDist, spotPos[w]
    mini.x     spotA, spotA, vf00[w]
    max.x      spotA, spotA, vf00[x]
    mul.x      spotC, spotC, spotA
    mul.xyz    spotD, spotColV, spotC[x]
    add.xyz    color1, color1, spotD
    sub.xyz    spotD, vertex2, spotPos  ; CalculateTyraSpotLight
    mul.xyz    spotSq, spotD, spotD
    add.x      spotDist, spotSq, spotSq[y]
    add.x      spotDist, spotDist, spotSq[z]
    mul.xyz    spotTm, spotD, spotDirV
    add.x      spotT, spotTm, spotTm[y]
    add.x      spotT, spotT, spotTm[z]
    max.x      spotT, spotT, vf00[x]
    mul.x      spotT, spotT, spotT
    mul.x      spotC, spotDist, spotDirV[w]
    sub.x      spotC, spotT, spotC
    mul.x      spotC, spotC, spotColV[w]
    mini.x     spotC, spotC, vf00[w]
    max.x      spotC, spotC, vf00[x]
    add.x      acc, vf00, vf00[w]
    msub.x     spotA, spotDist, spotPos[w]
    mini.x     spotA, spotA, vf00[w]
    max.x      spotA, spotA, vf00[x]
    mul.x      spotC, spotC, spotA
    mul.xyz    spotD, spotColV, spotC[x]
    add.xyz    color2, color2, spotD
    sub.xyz    spotD, vertex3, spotPos  ; CalculateTyraSpotLight
    mul.xyz    spotSq, spotD, spotD
    add.x      spotDist, spotSq, spotSq[y]
    add.x      spotDist, spotDist, spotSq[z]
    mul.xyz    spotTm, spotD, spotDirV
    add.x      spotT, spotTm, spotTm[y]
    add.x      spotT, spotT, spotTm[z]
    max.x      spotT, spotT, vf00[x]
    mul.x      spotT, spotT, spotT
    mul.x      spotC, spotDist, spotDirV[w]
    sub.x      spotC, spotT, spotC
    mul.x      spotC, spotC, spotColV[w]
    mini.x     spotC, spotC, vf00[w]
    max.x      spotC, spotC, vf00[x]
    add.x      acc, vf00, vf00[w]
    msub.x     spotA, spotDist, spotPos[w]
    mini.x     spotA, spotA, vf00[w]
    max.x      spotA, spotA, vf00[x]
    mul.x      spotC, spotC, spotA
    mul.xyz    spotD, spotColV, spotC[x]
    add.xyz    color3, color3, spotD
    loi        255
    mini.xyz   color1, color1, i
    loi        255
    mini.xyz   color2, color2, i
    loi        255
    mini.xyz   color3, color3, i
    mula       acc, mvp[0], vertex1[x]  ; MatrixMultiplyVertex
    madda      acc, mvp[1], vertex1[y]
    madda      acc, mvp[2], vertex1[z]
    madd       vertex1, mvp[3], vertex1[w]
    mula       acc, mvp[0], vertex2[x]  ; MatrixMultiplyVertex
    madda      acc, mvp[1], vertex2[y]
    madda      acc, mvp[2], vertex2[z]
    madd       vertex2, mvp[3], vertex2[w]
    mula       acc, mvp[0], vertex3[x]  ; MatrixMultiplyVertex
    madda      acc, mvp[1], vertex3[y]
    madda      acc, mvp[2], vertex3[z]
    madd       vertex3, mvp[3], vertex3[w]
    mul.xyz    vuS0, color1, k0
    add.x      vuS0, vuS0, vuS0[y]
    add.x      vuS0, vuS0, vuS0[z]
    mul.xyz    color1, k2, vuS0[x]
    add.xyz    color1, color1, k1
    mul.xyz    vuS0, color2, k0
    add.x      vuS0, vuS0, vuS0[y]
    add.x      vuS0, vuS0, vuS0[z]
    mul.xyz    color2, k2, vuS0[x]
    add.xyz    color2, color2, k1
    mul.xyz    vuS0, color3, k0
    add.x      vuS0, vuS0, vuS0[y]
    add.x      vuS0, vuS0, vuS0[z]
    mul.xyz    color3, k2, vuS0[x]
    add.xyz    color3, color3, k1
    clipw.xyz  vertex1, vertex1
    fcand      VI01, 0xF
    iadd       triOr, VI01, vi00
    sub.x      sjudge, cvec, vertex1[z]
    add.y      sjudge, cvec, vertex1[z]
    mul.w      sjudge, vf00, cvec[w]
    clipw.xyz  sjudge, sjudge
    fcand      VI01, 0xA
    ior        triOr, triOr, VI01
    clipw.xyz  vertex2, vertex2
    fcand      VI01, 0xF
    ior        triOr, triOr, VI01
    sub.x      sjudge, cvec, vertex2[z]
    add.y      sjudge, cvec, vertex2[z]
    mul.w      sjudge, vf00, cvec[w]
    clipw.xyz  sjudge, sjudge
    fcand      VI01, 0xA
    ior        triOr, triOr, VI01
    clipw.xyz  vertex3, vertex3
    fcand      VI01, 0xF
    ior        triOr, triOr, VI01
    sub.x      sjudge, cvec, vertex3[z]
    add.y      sjudge, cvec, vertex3[z]
    mul.w      sjudge, vf00, cvec[w]
    clipw.xyz  sjudge, sjudge
    fcand      VI01, 0xA
    ior        triOr, triOr, VI01
    sq         vertex1, 956(vi00)  ; VU1_CLIP_POLY_A_ADDR
    sq         stq1, 957(vi00)
    sq         color1, 958(vi00)
    sq         vertex2, 959(vi00)
    sq         stq2, 960(vi00)
    sq         color2, 961(vi00)
    sq         vertex3, 962(vi00)
    sq         stq3, 963(vi00)
    sq         color3, 964(vi00)
    iaddiu     srcBase, vi00, 956
    iaddiu     srcEnd, srcBase, 9
    ibeq       triOr, vi00, fanStart
    iaddiu     planePtr, vi00, 944  ; VU1_CLIP_PLANES_ADDR - near plane first
    iaddiu     dstBase, vi00, 986
planeLoop:
    lq         planeV, 0(planePtr)  ; inside = dot4(v, ABCD) + E >= 0
    lq         planeE, 1(planePtr)
    iaddi      prevPtr, srcEnd, -3
    lq         ppos, 0(prevPtr)
    lq         pstq, 1(prevPtr)
    lq         pcol, 2(prevPtr)
    mul        dtmp, ppos, planeV
    add.x      dtmp, dtmp, dtmp[y]
    add.x      dtmp, dtmp, dtmp[z]
    add.x      dtmp, dtmp, dtmp[w]
    add.x      pd, dtmp, planeE[x]
    iadd       curPtr, srcBase, vi00
    iadd       dstPtr, dstBase, vi00
edgeLoop:
    lq         cpos, 0(curPtr)
    lq         cstq, 1(curPtr)
    lq         ccol, 2(curPtr)
    mul        dtmp, cpos, planeV
    add.x      dtmp, dtmp, dtmp[y]
    add.x      dtmp, dtmp, dtmp[z]
    add.x      dtmp, dtmp, dtmp[w]
    add.x      cd, dtmp, planeE[x]
    add.x      sjudge, vf00, pd[x]
    add.y      sjudge, vf00, cd[x]
    sub.xy     sjudge, sjudge, cvec[w]
    mul.w      sjudge, vf00, cvec[w]
    clipw.xyz  sjudge, sjudge
    fcand      VI01, 0x2  ; prev outside?
    iadd       vertMask, VI01, vi00
    fcand      VI01, 0x8  ; cur outside?
    ibne       vertMask, VI01, edgeCross
    ibne       VI01, vi00, edgeAdvance
    b          edgeEmitCur
edgeCross:
    sub.x      dtmp, pd, cd[x]
    div        q, pd[x], dtmp[x]
    sub        lerpP, cpos, ppos
    mul        lerpP, lerpP, q
    add        lerpP, lerpP, ppos
    sub        lerpT, cstq, pstq
    mul        lerpT, lerpT, q
    add        lerpT, lerpT, pstq
    sub        lerpC, ccol, pcol
    mul        lerpC, lerpC, q
    add        lerpC, lerpC, pcol
    sq         lerpP, 0(dstPtr)
    sq         lerpT, 1(dstPtr)
    sq         lerpC, 2(dstPtr)
    iaddiu     dstPtr, dstPtr, 3
    ibne       VI01, vi00, edgeAdvance
edgeEmitCur:
    sq         cpos, 0(dstPtr)
    sq         cstq, 1(dstPtr)
    sq         ccol, 2(dstPtr)
    iaddiu     dstPtr, dstPtr, 3
edgeAdvance:
    move       ppos, cpos
    move       pstq, cstq
    move       pcol, ccol
    add.x      pd, vf00, cd[x]
    iaddiu     curPtr, curPtr, 3
    ibne       curPtr, srcEnd, edgeLoop
    ibeq       dstPtr, dstBase, triNext
    iadd       srcEnd, dstPtr, vi00
    iadd       vertMask, srcBase, vi00
    iadd       srcBase, dstBase, vi00
    iadd       dstBase, vertMask, vi00
    iaddiu     planePtr, planePtr, 2
    iaddiu     vertMask, vi00, 956
    ibne       planePtr, vertMask, planeLoop
fanStart:
    iaddiu     vertMask, srcBase, 9
    isub       vertMask, srcEnd, vertMask
    ibltz      vertMask, triNext
    iaddiu     fanPtr, srcBase, 3  ; (P0, Pj, Pj+1) for j = 1 .. n-2
fanLoop:
    iaddiu     fanNext, fanPtr, 3
    ibeq       fanNext, srcEnd, triNext
    iadd       emitPtr, srcBase, vi00
    iadd       emitNxt, fanPtr, vi00
    iaddiu     emitCnt, vi00, 3
fanEmitLoop:
    lq         ecPos, 0(emitPtr)
    lq         ecStq, 1(emitPtr)
    lq         ecCol, 2(emitPtr)
    add.x      ecFogF, vf00, ecPos[w]  ; CalculateTyraFog
    mul.x      ecFogF, ecFogF, fogParams[z]
    add.x      ecFogF, ecFogF, fogParams[w]
    loi        255
    mini.x     ecFogF, ecFogF, i
    max.x      ecFogF, ecFogF, vf00[x]
    ftoi4.x    ecFogF, ecFogF
    mtir       ecFog, ecFogF[x]
    isw.w      ecFog, 2(destAddress)
    div        q, vf00[w], ecPos[w]  ; VertexPersCorr
    mul.xyz    ecPos, ecPos, q
    mul        ecStq, ecStq, q
    mula.xyz   acc, scale, vf00[w]  ; ScaleVertexToGSFormat
    madd.xyz   ecPos, ecPos, scale
    ftoi4.xyz  ecPos, ecPos
    loi        255  ; FixColor: clamp to 0..255
    mini.xyz   ecCol, ecCol, i
    max.xyz    ecCol, ecCol, vf00[x]
    ftoi0      ecCol, ecCol
    sq         ecStq, 0(destAddress)
    sq         ecCol, 1(destAddress)
    sq.xyz     ecPos, 2(destAddress)
    iaddiu     destAddress, destAddress, 3
    iadd       emitPtr, emitNxt, vi00
    iadd       emitNxt, fanNext, vi00
    iaddi      emitCnt, emitCnt, -1
    ibgtz      emitCnt, fanEmitLoop
    iaddiu     outCount, outCount, 3
    iadd       fanPtr, fanNext, vi00
    b          fanLoop
triNext:
    iaddiu     vertexData, vertexData, 3
    iaddiu     stqData, stqData, 3
    iaddiu     colorData, colorData, 3
    iaddi      vertexCounter, vertexCounter, -3  ; decrement the loop counter
    ibgtz      vertexCounter, triLoop
    xtop       buffer
    iaddiu     vertexData, buffer, 2
    ilw.w      vertexCount, 0(buffer)
    iadd       vertexData, vertexData, vertexCount
    iadd       vertexData, vertexData, vertexCount
    ilw.x      sceFlag, 8(vi00)
    iblez      sceFlag, kickMulti
    b          kickPatch
kickMulti:
    iadd       vertexData, vertexData, vertexCount
kickPatch:
    iaddiu     vertMask, outCount, 16384
    iaddiu     vertMask, vertMask, 16384
    isw.x      vertMask, 8(vertexData)
    xgkick     vertexData  ; dispatch to the GS rasterizer

--barrier
--cont

    b          begin

#endvuprog

--exit
--endexit
