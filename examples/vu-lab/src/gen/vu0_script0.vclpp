; Generated by TyraX (src/vugen.cpp). Do not edit - regenerate from
; the description with: tyrax-editor --vu-emit <dir>
;
; Ranges - a VU0 COMPUTE KERNEL.
;
; Nothing of the VU1 pipeline is here and that is the point: no xtop
; (VIF0 is not double-buffered - the EE stores straight into VU0 data
; memory), no GIF tag block and no xgkick (VU0 has no path to the GS),
; and no branch back to a buffer loop - the program ENDS and the EE
; re-enters it at instruction 0 with the next vcallms.
;
; Data memory (quadword addresses, 256 TOTAL on VU0):
;   0  .x = element count for this call
;   1  user parameters
;   2  (time, sin time, cos time, 1.0)
;   8..71  input elements
;   72..135  output elements
;
; VU0's register file is SHARED with COP2 macro mode - the engine's own
; Vec4/M4x4 math. Nothing may run this kernel concurrently with that;
; the emitted driver blocks the EE for exactly this reason.

.syntax new
.name TyraXKernel0
.vu
.init_vf_all
.init_vi_all

--enter
--endenter

#vuprog TyraXKernel0

    ilw.x      count, 0(vi00)  ; elements in THIS call - the EE rewrites it per vcallms
    lq         params, 1(vi00)  ; the four user parameters - stored ONCE, they survive every vcallms because VU0 data memory persists
    lq         time, 2(vi00)  ; (time, sin time, cos time, 1.0), written by the driver
    add.xyz    one, vf00, vf00[w]  ; 1.0 in every field
    mul.w      one, vf00, vf00[w]
    iaddiu     inAddr, vi00, 8  ; the input block - a FIXED address, not an xtop
    iaddiu     outAddr, vi00, 72
    iblez      count, done
    loi        9.99999997e-07  ; constants
    add.x      k0, vf00, i
    loi        3
    add.y      k0, vf00, i
    loi        0
    add.z      k0, vf00, i
    loi        0
    mul.w      k0, vf00, i
elementLoop:
    lq         elem, 0(inAddr)
    sub.xyz    s0, elem, params
    mul.xyz    s1, s0, s0
    add.x      s1, s1, s1[y]
    add.x      s1, s1, s1[z]
    max.x      s1, s1, k0[x]
    rsqrt      q, vf00[w], s1[x]
    mul.x      s2, s1, q
    mul.x      s0, s2, params[w]
    mini.x     s0, s0, k0[y]
    ftoi0.x    s0, s0
    itof0.x    s0, s0
    add.x      elem, vf00, s2[x]
    add.y      elem, vf00, s0[x]
    add.z      elem, vf00, s1[x]
    sq         elem, 0(outAddr)
    iaddiu     inAddr, inAddr, 1
    iaddiu     outAddr, outAddr, 1
    iaddi      count, count, -1
    ibne       count, vi00, elementLoop
done:
    isw.y      count, 0(vi00)  ; elements left = 0: the kernel ran to completion

#endvuprog

--exit
--endexit
