    iblez      count, done
elementLoop:
    lq         elem, 0(inAddr)
    add.x      s0, elem, elem[z]  ; Wobble
    mul.x      s0, s0, stageK0[y]
    mul.x      s1, time, stageK0[z]
    add.x      s0, s0, s1
    mul.x      sinA, s0, sinK[x]  ; sin(): angle -> [-1,1) turns
    add.x      sinA, sinA, sinK[y]
    add.x      sinB, sinA, sinK[z]
    sub.x      sinB, sinB, sinK[z]
    sub.x      sinA, sinA, sinB
    add.x      sinA, sinA, sinA
    sub.x      sinA, sinA, one
    abs.x      sinB, sinA
    sub.x      sinB, one, sinB
    mul.x      sinC, sinA, sinB
    add.x      sinC, sinC, sinC
    add.x      sinC, sinC, sinC
