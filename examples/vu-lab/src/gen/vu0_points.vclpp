    mul.x      sinB, sinB, sinK[w]
    add.x      s2, sinC, sinB
    mul.x      s2, s2, stageK0[x]
    add.y      elem, elem, s2[x]
    add.x      s0, one, stageK0[w]  ; Squash / stretch
    add.y      s0, one, stageK1[x]
    add.z      s0, one, stageK0[w]
