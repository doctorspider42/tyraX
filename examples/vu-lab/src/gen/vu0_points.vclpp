    loi        0.5
    add.y      sinK, vf00, i
    loi        8388608
    add.z      sinK, vf00, i
    loi        0.224999994
    mul.w      sinK, vf00, i
    loi        1.5  ; constants
    add.x      stageK0, vf00, i
    loi        0.800000012
    add.y      stageK0, vf00, i
    loi        2.5
    add.z      stageK0, vf00, i
    loi        0
    mul.w      stageK0, vf00, i
