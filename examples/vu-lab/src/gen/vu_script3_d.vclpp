    add.x      k2, vf00, i
    loi        1.29999995
    add.y      k2, vf00, i
    loi        0.180000007
    add.z      k2, vf00, i
    loi        0
    mul.w      k2, vf00, i
    mul.x      vuS0, vertex1, k2[x]
    mul.z      vuS1, vertex1, k2[x]
    add.x      vuS0, vuS0, vuS1[z]
    mul.x      vuS1, vuTime, k2[y]
    add.x      vuS0, vuS0, vuS1[x]
    mul.x      vuS1, vuS0, k0[x]  ; sin(): angle -> [-1,1) turns
    add.x      vuS1, vuS1, k0[y]
    add.x      vuS2, vuS1, k0[z]
    sub.x      vuS2, vuS2, k0[z]
    sub.x      vuS1, vuS1, vuS2
