    sub.x      vuS1, vuS1, vuS2
    add.x      vuS1, vuS1, vuS1
    sub.x      vuS1, vuS1, k1
    abs.x      vuS2, vuS1
    sub.x      vuS2, k1, vuS2
    mul.x      vuS3, vuS1, vuS2
    add.x      vuS3, vuS3, vuS3
    add.x      vuS3, vuS3, vuS3
    abs.x      vuS2, vuS3
    mul.x      vuS2, vuS3, vuS2
    sub.x      vuS2, vuS2, vuS3
    mul.x      vuS2, vuS2, k0[w]
    add.x      vuS0, vuS3, vuS2
    mul.x      vuS0, vuS0, k2[z]
    add.y      vertex2, vertex2, vuS0[x]
    mula       acc, mvp[0], vertex2[x]  ; MatrixMultiplyVertex
    madda      acc, mvp[1], vertex2[y]
    madda      acc, mvp[2], vertex2[z]
    madd       vertex2, mvp[3], vertex2[w]
