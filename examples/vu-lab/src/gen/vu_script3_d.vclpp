    mul.xyz    vertex1, vertex1, q
    mula.xyz   acc, scale, vf00[w]  ; ScaleVertexToGSFormat
    madd.xyz   vertex1, vertex1, scale
    ftoi4.xyz  vertex1, vertex1
    mula.xyz   acc, lightMatrix[0], normal1[x]  ; CalculateTyraDirectionalLights
    madda.xyz  acc, lightMatrix[1], normal1[y]
    madd.xyz   normal1, lightMatrix[2], normal1[z]
