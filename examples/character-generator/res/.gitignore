# Authored assets (models, textures, materials, ui, audio, sfx) are
# checked in - a pulled project must render without missing files. Only
# build-regenerated output is ignored.
/menus/

# Baked model output - the .glb/.obj next to it is the source, these are
# regenerated on every build (docs/model-pipeline.md).
/models/*.tskl
/models/*.tanm
/models/*.tmdl

# Baked model output at ANY depth, and the Character Generator's
# folder - only the .glb is a source there, and it EMBEDS its
# textures (docs/character-generator.md).
*.tskl
*.tanm
*.tmdl
/models/characters/*.png
# ...except a crowd's colour variants: SOURCES the generator wrote, which
# texbake fits into palettes (docs/character-generator.md, "Crowds").
!/models/characters/*.v[0-9].png
!/models/characters/*.v[0-9][0-9].png

# Baked credits page strips - regenerated on every build (docs/credits.md).
# The images an Image block points at live in res/credits/ and stay checked in.
/credits/pages/

# Baked memory card icon - icon.sys + list.icn, regenerated on every
# build from the Save Editor's settings (docs/save-editor.md).
/save/
