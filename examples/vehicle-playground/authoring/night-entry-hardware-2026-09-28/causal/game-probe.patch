+namespace budgetProbe {
+static unsigned mask = 0;
+static bool initialized = false, exported = false;
+static unsigned warmFrames = 0;
+static unsigned ticks() { unsigned t; asm volatile("mfc0 %0, $9" : "=r"(t)); return t; }
+static void init(Tyra::StaPipCore& core) {
+  if (initialized) return;
+  initialized = true;
+  FILE* f = fopen(Tyra::FileUtils::fromCwd("budget-probe.cfg").c_str(), "r");
+  if (f) { fscanf(f, "%u", &mask); fclose(f); }
+  core.budgetCacheCounts((mask & 128U) != 0);
+}
+struct Obj { unsigned seen = 0; unsigned long long elapsed = 0, sum[18] = {}; };
+static Obj objects[256];
+struct Snap { unsigned values[18]; };
+static Snap peek(const Tyra::StaPipCore& core) {
+  const auto& t = core.budgetPeekTelemetry();
+  const auto& c = core.budgetPeekCache();
+  return {{t.boundsTicks,t.prepareTicks,t.dispatchTicks,t.vu1WaitTicks,
+    t.attrib.gifWaitTicks,t.attrib.prepLightTicks,t.attrib.prepTextureTicks,
+    t.attrib.bdCacheTicks,c.recalcTicks,t.packetBuildTicks,
+    t.attrib.renderCalls,t.attrib.renderCallsCulled,t.trianglesCull+t.trianglesClip,
+    t.verticesSubmitted,c.hits,c.recalcs,c.fresh,c.probes}};
+}
+static void record(int i, unsigned elapsed, const Snap& a, const Snap& b) {
+  if (i < 0 || i >= 256) return;
+  Obj& o=objects[i]; ++o.seen; o.elapsed+=elapsed;
+  for(unsigned k=0;k<18;++k) o.sum[k]+=b.values[k]-a.values[k];
+}
+static void save() {
+  if (exported) return;
+  exported=true;
+  FILE* f=fopen(Tyra::FileUtils::fromCwd("object-cost.csv").c_str(),"w");
+  if(!f)return;
+  fprintf(f,"object,seen,warm_frames,elapsed_ms,bounds_ms,prepare_ms,dispatch_ms,vif_wait_ms,gif_wait_ms,pick_light_ms,texture_ms,bbox_cache_ms,bbox_recalc_ms,packet_ms,calls,culled,triangles,vertices,bbox_hits,bbox_recalcs,bbox_fresh,bbox_probes\n");
+  const double n=warmFrames ? warmFrames : 1;
+  for(unsigned i=0;i<256;++i) {
+    const Obj& o=objects[i]; if(!o.seen)continue;
+    fprintf(f,"%u,%u,%u,%.6f",i,o.seen,warmFrames,o.elapsed/(294912.0*n));
+    for(unsigned k=0;k<18;++k)fprintf(f,",%.6f",o.sum[k]/(k<10?294912.0*n:n));
+    fprintf(f,"\n");
+  }
+  fclose(f);
+  f=fopen(Tyra::FileUtils::fromCwd("budget-probe.csv").c_str(),"w");
+  if(f){fprintf(f,"mask,warm_frames\n%u,%u\n",mask,warmFrames);fclose(f);}
+}
+}
