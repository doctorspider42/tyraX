# C++-backed custom node: outputs an object picked at RUNTIME (the nearest
# visible one), so its object output can drive a built-in Hide Object. See
# inc/scripts/flow_nodes.hpp for flowNearestVisible().
#
# It takes no parameters, so it has no tips - `desc` alone is its documentation.
title = Nearest Visible
category = Custom
desc = On exec, picks the scene object nearest the player that is currently visible and LATCHES it on the object output; the after exec fires right behind, so whatever reads the object runs with it already set. Wire the object output into any built-in object action.
out = object
exec_out = true
call = flowNearestVisible
---
