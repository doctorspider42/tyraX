build/
.vs/
*.user
imgui.ini

# PS2 network-deploy tools, fetched by setup.ps1 (ps2client + ps2link)...
tools/*
!tools/ps2client/
tools/ps2client/*
!tools/ps2client/bin/
tools/ps2client/bin/*
# ...except the patched ps2client (TCP_NODELAY - see tools/ps2client/README.md;
# without it host: file serving to a real console runs at ~4 KB/s)
!tools/ps2client/bin/ps2client.exe
!tools/ps2client/nodelay.patch
!tools/ps2client/README.md
# ...and the SPU silencer used by Stop on PS2 (source + prebuilt ELF; see
# tools/silencer/Makefile - it builds inside the toolchain container)
!tools/silencer/
tools/silencer/*
!tools/silencer/main.c
!tools/silencer/Makefile
!tools/silencer/silencer.elf
# ...and the VS Code extension for .flownode/.screenfx files (see
# tools/vscode-tyrax/README.md; its own .gitignore drops *.vsix + node_modules).
!tools/vscode-tyrax/

# Vendored dependencies are fetched separately (see README)...
vendor/*
# ...except the Tyra engine, which is maintained in-tree: the editor edits
# it directly and syncs it into the build container (Apache License 2.0,
# forked from github.com/h4570/tyra @ 9273416).
!vendor/tyra/
vendor/tyra/*
!vendor/tyra/engine/
!vendor/tyra/Makefile.base
!vendor/tyra/README.MD
# Prebuilt audsrv with L/R panning, overlaid onto the container's PS2SDK at
# build time (see vendor/tyra/audsrv-pan/README.md).
!vendor/tyra/audsrv-pan/
vendor/tyra/engine/obj/
vendor/tyra/engine/bin/
