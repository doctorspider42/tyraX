build/
.vs/
*.user
imgui.ini

# PS2 network-deploy tools, fetched by setup.ps1 (ps2client + ps2link)
tools/

# Vendored dependencies are fetched separately (see README)...
vendor/*
# ...except the Tyra engine, which is maintained in-tree: the editor edits
# it directly and syncs it into the build container (Apache License 2.0,
# forked from github.com/h4570/tyra @ 9273416).
!vendor/tyra/
vendor/tyra/*
!vendor/tyra/engine/
!vendor/tyra/Makefile.base
!vendor/tyra/README.MD
# Prebuilt audsrv with L/R panning, overlaid onto the container's PS2SDK at
# build time (see vendor/tyra/audsrv-pan/README.md).
!vendor/tyra/audsrv-pan/
vendor/tyra/engine/obj/
vendor/tyra/engine/bin/
