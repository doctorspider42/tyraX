; Sandro Sobczyński <sandro.sobczynski@gmail.com>
; Modified by tyra-editor: VU1 clipping program (clip family).
;
;---------------------------------------------------------------
; Triangle list
; Clip = replaces the EE clipper for frustum-crossing packages.
;
; Per triangle:
; - transform to clip space, judge each vertex against the X/Y guard
;   band (|x|,|y| <= w - the clipw bound the cull programs use; the GS
;   scissor trims the overhang pixel-exactly) and the exact near/far
;   planes (constant z in Tyra's clip space; folded into a second clipw
;   judgement via the biased constants at VU1_CLIP_CONSTS_ADDR).
; - all 3 verts inside -> emit unchanged (the common case)
; - all 3 outside one plane -> dropped
; - crossing -> Sutherland-Hodgman against the 6 planes uploaded at
;   VU1_CLIP_PLANES_ADDR (near plane FIRST: everything that survives it
;   has w > 0, so the w-relative side planes are safe), then the result
;   polygon is fan-triangulated and emitted.
; The prim giftag NLOOP is patched with the emitted vertex count.
; ADC bits are never derived from clip flags (the historically fragile
; path) - every emitted vertex stores ADC = 0 plus the fog coefficient.
; Colors
;---------------------------------------------------------------

.syntax new
.name StaPipVU1Clip_C
.vu
.init_vf_all
.init_vi_all

#include "src/renderer/3d/pipeline/shared/vcl_sml.i"
#include "src/renderer/3d/pipeline/shared/tyra_macros.i"
#include "inc/renderer/3d/pipeline/static/core/programs/stapip_vu1_shared_defines.h"

#define RGBA_STORE_OFFSET   0
#define XYZ2_STORE_OFFSET   1

; scratch polygon vertex: [pos, color] (stride 2)

;---------------------------------------------------------
; EmitClipVertexC - load [pos, color] from t_ptr (scratch),
; apply fog + perspective divide + GS scale + color clamp
; and store the RGBAQ/XYZF2 pair at t_dest (advances t_dest
; by 2). Raw instructions only - vclpp macros do not nest.
;---------------------------------------------------------
#macro EmitClipVertexC: t_ptr, t_dest, t_scale, t_fogParams
   lq          ecPos,      0(t_ptr)
   lq          ecCol,      1(t_ptr)
   add.x       ecFogF,     vf00,       ecPos[w]
   mul.x       ecFogF,     ecFogF,     t_fogParams[z]
   add.x       ecFogF,     ecFogF,     t_fogParams[w]
   loi         255
   mini.x      ecFogF,     ecFogF,     i
   max.x       ecFogF,     ecFogF,     vf00[x]
   ftoi4.x     ecFogF,     ecFogF
   mtir        ecFog,      ecFogF[x]
   isw.w       ecFog,      1(t_dest)
   div         q,          vf00[w],    ecPos[w]
   mul.xyz     ecPos,      ecPos,      q
   mula.xyz    acc,        t_scale,    vf00[w]
   madd.xyz    ecPos,      ecPos,      t_scale
   ftoi4.xyz   ecPos,      ecPos
   loi         255
   mini.xyz    ecCol,      ecCol,      i
   max.xyz     ecCol,      ecCol,      vf00[x]
   ftoi0       ecCol,      ecCol
   sq          ecCol,      0(t_dest)
   sq.xyz      ecPos,      1(t_dest)
   iaddiu      t_dest,     t_dest,     2
#endmacro

--enter
--endenter

#vuprog StaPipVU1ClipC

    ResetClipFlags{ }
    LoadTyraStaticData{ gifSetTag }
    MatrixLoad{ mvp, VU1_MVP_MATRIX_ADDR, vi00 }
    LoadTyraTags{ lodGifTag, testsTag, VU1_LOD_ADDR, VU1_Z_TESTS_ADDR }
    ; Modified by tyra-editor: GS hardware fog (packed XYZF2)
    LoadTyraFogParams{ fogParams, VU1_OPTIONS_ADDR }
    ; Modified by tyra-editor: spot light (flashlight)
    LoadTyraSpotLight{ spotPos, spotDirV, spotColV, VU1_LIGHTS_DIRS_ADDR }
    ; single color (also reloaded as an int flag per triangle - VI pressure)
    lq          singleColor, VU1_SINGLE_COLOR_ADDR(vi00)
    ; clip constants: x = nearZ-GUARD, y = -farZ-GUARD, z = 0, w = GUARD
    lq          cvec,       VU1_CLIP_CONSTS_ADDR(vi00)
    ; judge vertex: x/y rewritten per use, z stays 0, w stays GUARD
    move        sjudge,     cvec

begin:
    xtop buffer
    LoadTyraBufferTags{ scale, primTag, buffer }

    iaddiu  vertexData,         buffer,         VU1_STAPIP_VERT_DATA_ADDR
    ilw.w   vertexCount,        0(buffer)
    iadd    colorData,          vertexData,     vertexCount
    ilw.x   sceFlag,            VU1_OPTIONS_ADDR(vi00)
    iblez   sceFlag,            setDestAddrMultiColor
    iadd    destAddress,        vertexData,     vertexCount
    b       setDestAddr
setDestAddrMultiColor:
    iadd    destAddress,        colorData,      vertexCount
setDestAddr:

    StoreTyraGifTags{ gifSetTag, lodGifTag, primTag, testsTag, destAddress }

    iaddiu  outCount,       vi00,           0
    iadd    vertexCounter,  vi00,           vertexCount
triLoop:

        ilw.x   sceFlag,    VU1_OPTIONS_ADDR(vi00)
        iblez   sceFlag,    multiColor
        add      color1,    vf00,   singleColor
        add      color2,    vf00,   singleColor
        add      color3,    vf00,   singleColor
        b processing

multiColor:
        lq      color1,   (colorData)
        lq      color2,   1(colorData)
        lq      color3,   2(colorData)

processing:
        lq      vertex1,  (vertexData)
        lq      vertex2,  1(vertexData)
        lq      vertex3,  2(vertexData)

        ; spot light on the object-space verts, before the transform and
        ; before clipping interpolates the colors (mirrors the EE
        ; clipper's addSpotToColor)
        CalculateTyraSpotLight{ color1, vertex1, spotPos, spotDirV, spotColV }
        CalculateTyraSpotLight{ color2, vertex2, spotPos, spotDirV, spotColV }
        CalculateTyraSpotLight{ color3, vertex3, spotPos, spotDirV, spotColV }

        MatrixMultiplyVertex{ vertex1, mvp, vertex1 }
        MatrixMultiplyVertex{ vertex2, mvp, vertex2 }
        MatrixMultiplyVertex{ vertex3, mvp, vertex3 }

        ; --- crossing judgement. fcand sets VI01 to 0/1 (any masked bit
        ; set), so per-vertex we learn "outside something", not which
        ; plane - enough to route the triangle. Real vertex bits 0-3:
        ; +x,-x,+y,-y = outside the X/Y guard band; judge vertex: -x
        ; (bit 1) = near violated, -y (bit 3) = far violated.
        clipw.xyz   vertex1,    vertex1
        fcand       VI01,       0xF
        iadd        triOr,      VI01,       vi00
        sub.x       sjudge,     cvec,       vertex1[z]
        add.y       sjudge,     cvec,       vertex1[z]
        mul.w       sjudge,     vf00,       cvec[w]
        clipw.xyz   sjudge,     sjudge
        fcand       VI01,       0xA
        ior         triOr,      triOr,      VI01

        clipw.xyz   vertex2,    vertex2
        fcand       VI01,       0xF
        ior         triOr,      triOr,      VI01
        sub.x       sjudge,     cvec,       vertex2[z]
        add.y       sjudge,     cvec,       vertex2[z]
        mul.w       sjudge,     vf00,       cvec[w]
        clipw.xyz   sjudge,     sjudge
        fcand       VI01,       0xA
        ior         triOr,      triOr,      VI01

        clipw.xyz   vertex3,    vertex3
        fcand       VI01,       0xF
        ior         triOr,      triOr,      VI01
        sub.x       sjudge,     cvec,       vertex3[z]
        add.y       sjudge,     cvec,       vertex3[z]
        mul.w       sjudge,     vf00,       cvec[w]
        clipw.xyz   sjudge,     sjudge
        fcand       VI01,       0xA
        ior         triOr,      triOr,      VI01

        ; any vert outside any plane -> real clipping (fully-outside
        ; triangles come out of Sutherland-Hodgman empty)
        ibne        triOr,      vi00,       triClip

        ; --- fast path: triangle entirely inside ---
        CalculateTyraFog{ fogInt, vertex1, fogParams }
        StoreTyraFog{ fogInt, destAddress, XYZ2_STORE_OFFSET }
        VertexPersCorr{ vertex1, vertex1 }
        ScaleVertexToGSFormat{ scale, vertex1 }
        FixColor{ color1 }

        CalculateTyraFog{ fogInt, vertex2, fogParams }
        StoreTyraFog{ fogInt, destAddress, XYZ2_STORE_OFFSET+2 }
        VertexPersCorr{ vertex2, vertex2 }
        ScaleVertexToGSFormat{ scale, vertex2 }
        FixColor{ color2 }

        CalculateTyraFog{ fogInt, vertex3, fogParams }
        StoreTyraFog{ fogInt, destAddress, XYZ2_STORE_OFFSET+4 }
        VertexPersCorr{ vertex3, vertex3 }
        ScaleVertexToGSFormat{ scale, vertex3 }
        FixColor{ color3 }

        sq      color1,         RGBA_STORE_OFFSET(destAddress)
        sq.xyz  vertex1,        XYZ2_STORE_OFFSET(destAddress)
        sq      color2,         RGBA_STORE_OFFSET+2(destAddress)
        sq.xyz  vertex2,        XYZ2_STORE_OFFSET+2(destAddress)
        sq      color3,         RGBA_STORE_OFFSET+4(destAddress)
        sq.xyz  vertex3,        XYZ2_STORE_OFFSET+4(destAddress)

        iaddiu  destAddress,    destAddress,    6
        iaddiu  outCount,       outCount,       3
        b       triNext

triClip:
        ; --- Sutherland-Hodgman in the scratch area ---
        sq      vertex1,    VU1_CLIP_POLY_A_ADDR+0(vi00)
        sq      color1,     VU1_CLIP_POLY_A_ADDR+1(vi00)
        sq      vertex2,    VU1_CLIP_POLY_A_ADDR+2(vi00)
        sq      color2,     VU1_CLIP_POLY_A_ADDR+3(vi00)
        sq      vertex3,    VU1_CLIP_POLY_A_ADDR+4(vi00)
        sq      color3,     VU1_CLIP_POLY_A_ADDR+5(vi00)

        iaddiu  planePtr,   vi00,       VU1_CLIP_PLANES_ADDR
        iaddiu  srcBase,    vi00,       VU1_CLIP_POLY_A_ADDR
        iaddiu  dstBase,    vi00,       VU1_CLIP_POLY_B_ADDR
        iaddiu  srcEnd,     srcBase,    6

planeLoop:
        lq      planeV,     0(planePtr)
        lq      planeE,     1(planePtr)

        ; prev = last polygon vertex, pd = dot4(prev, plane) + E
        iaddi   prevPtr,    srcEnd,     -2
        lq      ppos,       0(prevPtr)
        lq      pcol,       1(prevPtr)
        mul     dtmp,       ppos,       planeV
        add.x   dtmp,       dtmp,       dtmp[y]
        add.x   dtmp,       dtmp,       dtmp[z]
        add.x   dtmp,       dtmp,       dtmp[w]
        add.x   pd,         dtmp,       planeE[x]

        iadd    curPtr,     srcBase,    vi00
        iadd    dstPtr,     dstBase,    vi00

edgeLoop:
        lq      cpos,       0(curPtr)
        lq      ccol,       1(curPtr)
        mul     dtmp,       cpos,       planeV
        add.x   dtmp,       dtmp,       dtmp[y]
        add.x   dtmp,       dtmp,       dtmp[z]
        add.x   dtmp,       dtmp,       dtmp[w]
        add.x   cd,         dtmp,       planeE[x]

        ; sign of pd / cd through one clipw judgement:
        ; sjudge = (pd - GUARD, cd - GUARD, ?, GUARD)
        ; -x bit = pd < 0 (prev outside), -y bit = cd < 0 (cur outside).
        ; fcand yields 0/1, so the two bits are read with separate fcands.
        add.x   sjudge,     vf00,       pd[x]
        add.y   sjudge,     vf00,       cd[x]
        sub.xy  sjudge,     sjudge,     cvec[w]
        mul.w   sjudge,     vf00,       cvec[w]
        clipw.xyz sjudge,   sjudge
        fcand   VI01,       0x2                         ; prev outside?
        iadd    vertMask,   VI01,       vi00
        fcand   VI01,       0x8                         ; cur outside?

        ibne    vertMask,   VI01,       edgeCross       ; signs differ
        ibne    VI01,       vi00,       edgeAdvance     ; both outside
        b       edgeEmitCur                             ; both inside

edgeCross:
        ; edge crosses the plane -> emit the intersection
        ; t = pd / (pd - cd); out = prev + (cur - prev) * t
        sub.x   dtmp,       pd,         cd[x]
        div     q,          pd[x],      dtmp[x]
        sub     lerpP,      cpos,       ppos
        mul     lerpP,      lerpP,      q
        add     lerpP,      lerpP,      ppos
        sub     lerpC,      ccol,       pcol
        mul     lerpC,      lerpC,      q
        add     lerpC,      lerpC,      pcol
        sq      lerpP,      0(dstPtr)
        sq      lerpC,      1(dstPtr)
        iaddiu  dstPtr,     dstPtr,     2
        ; when cur is inside too, it is emitted as well
        ibne    VI01,       vi00,       edgeAdvance     ; cur outside
edgeEmitCur:
        sq      cpos,       0(dstPtr)
        sq      ccol,       1(dstPtr)
        iaddiu  dstPtr,     dstPtr,     2
edgeAdvance:
        move    ppos,       cpos
        move    pcol,       ccol
        add.x   pd,         vf00,       cd[x]
        iaddiu  curPtr,     curPtr,     2
        ibne    curPtr,     srcEnd,     edgeLoop

        ; polygon fully clipped away?
        ibeq    dstPtr,     dstBase,    triNext
        ; swap src <-> dst for the next plane
        iadd    srcEnd,     dstPtr,     vi00
        iadd    vertMask,   srcBase,    vi00
        iadd    srcBase,    dstBase,    vi00
        iadd    dstBase,    vertMask,   vi00
        iaddiu  planePtr,   planePtr,   2
        iaddiu  vertMask,   vi00,       VU1_CLIP_PLANES_ADDR+12
        ibne    planePtr,   vertMask,   planeLoop

        ; fewer than 3 verts left -> nothing to draw
        iaddiu  vertMask,   srcBase,    6
        isub    vertMask,   srcEnd,     vertMask
        ibltz   vertMask,   triNext

        ; fan-triangulate: (P0, Pj, Pj+1) for j = 1 .. n-2
        iaddiu  fanPtr,     srcBase,    2
fanLoop:
        iaddiu  fanNext,    fanPtr,     2
        ibeq    fanNext,    srcEnd,     triNext

        EmitClipVertexC{ srcBase, destAddress, scale, fogParams }
        EmitClipVertexC{ fanPtr,  destAddress, scale, fogParams }
        EmitClipVertexC{ fanNext, destAddress, scale, fogParams }
        iaddiu  outCount,   outCount,   3

        iadd    fanPtr,     fanNext,    vi00
        b       fanLoop

triNext:
        iaddiu  vertexData,     vertexData,     3
        iaddiu  colorData,      colorData,      3
        iaddi   vertexCounter,  vertexCounter,  -3
        ibne    vertexCounter,  vi00,   triLoop

    ; rebuild the kick address (xtop is stable within one activation) and
    ; patch the prim giftag NLOOP (word 0 = outCount | EOP)
    xtop    buffer
    iaddiu  vertexData, buffer,     VU1_STAPIP_VERT_DATA_ADDR
    ilw.w   vertexCount, 0(buffer)
    iadd    vertexData, vertexData, vertexCount
    ilw.x   sceFlag,    VU1_OPTIONS_ADDR(vi00)
    iblez   sceFlag,    kickMulti
    b       kickPatch
kickMulti:
    iadd    vertexData, vertexData, vertexCount
kickPatch:
    iaddiu  vertMask,   outCount,   0x4000
    iaddiu  vertMask,   vertMask,   0x4000
    isw.x   vertMask,   4(vertexData)

    xgkick vertexData ; dispatch to the GS rasterizer.

--barrier ; Why the hell I must add barrier AFTER XGKICK? VCL does not adds E bit without it...
--cont

    b   begin

#endvuprog

--exit
--endexit
