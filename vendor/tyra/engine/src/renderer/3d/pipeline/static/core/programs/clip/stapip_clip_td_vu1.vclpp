; Sandro Sobczyński <sandro.sobczynski@gmail.com>
; Modified by TyraX: VU1 clipping program (clip family).
;
;---------------------------------------------------------------
; Triangle list
; Clip = replaces the EE clipper for frustum-crossing packages.
; Same structure as stapip_clip_c_vu1.vclpp (see the design notes
; there). Directional lighting is evaluated on the ORIGINAL three
; vertices (see stapip_clip_d_vu1.vclpp for the rationale); the
; scratch polygon carries [pos, stq, lit color] (stride 3).
; Texture, directional lights
;---------------------------------------------------------------

.syntax new
.name StaPipVU1Clip_TD
.vu
.init_vf_all
.init_vi_all

#include "src/renderer/3d/pipeline/shared/vcl_sml.i"
#include "src/renderer/3d/pipeline/shared/tyra_macros.i"
#include "inc/renderer/3d/pipeline/static/core/programs/stapip_vu1_shared_defines.h"

#define STQ_STORE_OFFSET    0
#define RGBA_STORE_OFFSET   1
#define XYZ2_STORE_OFFSET   2

;---------------------------------------------------------
; EmitClipVertexTD - load [pos, stq, lit color] from t_ptr,
; fog + perspective divide (position and STQ) + GS scale +
; color clamp, store STQ/RGBAQ/XYZF2 at t_dest (advances
; t_dest by 3). Raw instructions only.
;---------------------------------------------------------
#macro EmitClipVertexTD: t_ptr, t_dest, t_scale, t_fogParams
   lq          ecPos,      0(t_ptr)
   lq          ecStq,      1(t_ptr)
   lq          ecCol,      2(t_ptr)
   add.x       ecFogF,     vf00,       ecPos[w]
   mul.x       ecFogF,     ecFogF,     t_fogParams[z]
   add.x       ecFogF,     ecFogF,     t_fogParams[w]
   loi         255
   mini.x      ecFogF,     ecFogF,     i
   max.x       ecFogF,     ecFogF,     vf00[x]
   ftoi4.x     ecFogF,     ecFogF
   mtir        ecFog,      ecFogF[x]
   isw.w       ecFog,      2(t_dest)
   div         q,          vf00[w],    ecPos[w]
   mul.xyz     ecPos,      ecPos,      q
   mul         ecStq,      ecStq,      q
   mula.xyz    acc,        t_scale,    vf00[w]
   madd.xyz    ecPos,      ecPos,      t_scale
   ftoi4.xyz   ecPos,      ecPos
   loi         255
   mini.xyz    ecCol,      ecCol,      i
   max.xyz     ecCol,      ecCol,      vf00[x]
   ftoi0       ecCol,      ecCol
   sq          ecStq,      0(t_dest)
   sq          ecCol,      1(t_dest)
   sq.xyz      ecPos,      2(t_dest)
   iaddiu      t_dest,     t_dest,     3
#endmacro

--enter
--endenter

#vuprog StaPipVU1ClipTD

    ResetClipFlags{ }
    LoadTyraStaticData{ gifSetTag }
    MatrixLoad{ mvp, VU1_MVP_MATRIX_ADDR, vi00 }
    LoadTyraTagsTexture{ lodGifTag, testsTag, texBufferClutGifTag, VU1_LOD_ADDR, VU1_Z_TESTS_ADDR, VU1_CLUT_ADDR }
    ; Modified by TyraX: GS hardware fog (packed XYZF2)
    LoadTyraFogParams{ fogParams, VU1_OPTIONS_ADDR }
    ; clip constants: x = nearZ-GUARD, y = -farZ-GUARD, z = 0, w = GUARD
    lq          cvec,       VU1_CLIP_CONSTS_ADDR(vi00)
    ; judge vertex: x/y/w rewritten per use
    move        sjudge,     cvec

begin:
    xtop buffer
    LoadTyraBufferTags{ scale, primTag, buffer }

    iaddiu  vertexData,         buffer,         VU1_STAPIP_VERT_DATA_ADDR
    ilw.w   vertexCount,        0(buffer)
    iadd    stqData,            vertexData,     vertexCount
    iadd    normalData,         stqData,        vertexCount
    iadd    destAddress,        normalData,     vertexCount

    StoreTyraGifTagsTexture{ gifSetTag, lodGifTag, texBufferClutGifTag, primTag, testsTag, destAddress }

    iaddiu  outCount,       vi00,           0
    iadd    vertexCounter,  vi00,           vertexCount
triLoop:

        lq      vertex1,  (vertexData)
        lq      vertex2,  1(vertexData)
        lq      vertex3,  2(vertexData)
        lq      stq1,     (stqData)
        lq      stq2,     1(stqData)
        lq      stq3,     2(stqData)
        lq.xyz  normal1,  (normalData)
        lq.xyz  normal2,  1(normalData)
        lq.xyz  normal3,  2(normalData)

        ; light the original verts; colors are interpolated through the
        ; cuts (see stapip_clip_d_vu1.vclpp)
        LoadTyraDirectionalLights{ lightMatrix, lightDirections, lightColors, ambientColor, VU1_LIGHTS_DIRS_ADDR, VU1_LIGHTS_COLORS_ADDR, VU1_LIGHTS_MATRIX_ADDR }
        CalculateTyraDirectionalLights{ color1, normal1, lightDirections, lightColors, lightMatrix, ambientColor }
        CalculateTyraDirectionalLights{ color2, normal2, lightDirections, lightColors, lightMatrix, ambientColor }
        CalculateTyraDirectionalLights{ color3, normal3, lightDirections, lightColors, lightMatrix, ambientColor }

        MatrixMultiplyVertex{ vertex1, mvp, vertex1 }
        MatrixMultiplyVertex{ vertex2, mvp, vertex2 }
        MatrixMultiplyVertex{ vertex3, mvp, vertex3 }

        ; --- crossing judgement (see stapip_clip_c_vu1.vclpp) ---
        clipw.xyz   vertex1,    vertex1
        fcand       VI01,       0xF
        iadd        triOr,      VI01,       vi00
        sub.x       sjudge,     cvec,       vertex1[z]
        add.y       sjudge,     cvec,       vertex1[z]
        mul.w       sjudge,     vf00,       cvec[w]
        clipw.xyz   sjudge,     sjudge
        fcand       VI01,       0xA
        ior         triOr,      triOr,      VI01

        clipw.xyz   vertex2,    vertex2
        fcand       VI01,       0xF
        ior         triOr,      triOr,      VI01
        sub.x       sjudge,     cvec,       vertex2[z]
        add.y       sjudge,     cvec,       vertex2[z]
        mul.w       sjudge,     vf00,       cvec[w]
        clipw.xyz   sjudge,     sjudge
        fcand       VI01,       0xA
        ior         triOr,      triOr,      VI01

        clipw.xyz   vertex3,    vertex3
        fcand       VI01,       0xF
        ior         triOr,      triOr,      VI01
        sub.x       sjudge,     cvec,       vertex3[z]
        add.y       sjudge,     cvec,       vertex3[z]
        mul.w       sjudge,     vf00,       cvec[w]
        clipw.xyz   sjudge,     sjudge
        fcand       VI01,       0xA
        ior         triOr,      triOr,      VI01

        ; --- clip-space triangle to the scratch polygon (stride 3) ---
        sq      vertex1,    VU1_CLIP_POLY_A_ADDR+0(vi00)
        sq      stq1,       VU1_CLIP_POLY_A_ADDR+1(vi00)
        sq      color1,     VU1_CLIP_POLY_A_ADDR+2(vi00)
        sq      vertex2,    VU1_CLIP_POLY_A_ADDR+3(vi00)
        sq      stq2,       VU1_CLIP_POLY_A_ADDR+4(vi00)
        sq      color2,     VU1_CLIP_POLY_A_ADDR+5(vi00)
        sq      vertex3,    VU1_CLIP_POLY_A_ADDR+6(vi00)
        sq      stq3,       VU1_CLIP_POLY_A_ADDR+7(vi00)
        sq      color3,     VU1_CLIP_POLY_A_ADDR+8(vi00)

        iaddiu  srcBase,    vi00,       VU1_CLIP_POLY_A_ADDR
        iaddiu  srcEnd,     srcBase,    9

        ; fully inside -> no clipping, straight to the emitter
        ibeq    triOr,      vi00,       fanStart

        ; --- Sutherland-Hodgman against the 6 planes ---
        iaddiu  planePtr,   vi00,       VU1_CLIP_PLANES_ADDR
        iaddiu  dstBase,    vi00,       VU1_CLIP_POLY_B_ADDR

planeLoop:
        lq      planeV,     0(planePtr)
        lq      planeE,     1(planePtr)

        ; prev = last polygon vertex, pd = dot4(prev, plane) + E
        iaddi   prevPtr,    srcEnd,     -3
        lq      ppos,       0(prevPtr)
        lq      pstq,       1(prevPtr)
        lq      pcol,       2(prevPtr)
        mul     dtmp,       ppos,       planeV
        add.x   dtmp,       dtmp,       dtmp[y]
        add.x   dtmp,       dtmp,       dtmp[z]
        add.x   dtmp,       dtmp,       dtmp[w]
        add.x   pd,         dtmp,       planeE[x]

        iadd    curPtr,     srcBase,    vi00
        iadd    dstPtr,     dstBase,    vi00

edgeLoop:
        lq      cpos,       0(curPtr)
        lq      cstq,       1(curPtr)
        lq      ccol,       2(curPtr)
        mul     dtmp,       cpos,       planeV
        add.x   dtmp,       dtmp,       dtmp[y]
        add.x   dtmp,       dtmp,       dtmp[z]
        add.x   dtmp,       dtmp,       dtmp[w]
        add.x   cd,         dtmp,       planeE[x]

        ; sign of pd / cd through one clipw judgement (see clip_c)
        add.x   sjudge,     vf00,       pd[x]
        add.y   sjudge,     vf00,       cd[x]
        sub.xy  sjudge,     sjudge,     cvec[w]
        mul.w   sjudge,     vf00,       cvec[w]
        clipw.xyz sjudge,   sjudge
        fcand   VI01,       0x2                         ; prev outside?
        iadd    vertMask,   VI01,       vi00
        fcand   VI01,       0x8                         ; cur outside?

        ibne    vertMask,   VI01,       edgeCross       ; signs differ
        ibne    VI01,       vi00,       edgeAdvance     ; both outside
        b       edgeEmitCur                             ; both inside

edgeCross:
        ; t = pd / (pd - cd); out = prev + (cur - prev) * t
        sub.x   dtmp,       pd,         cd[x]
        div     q,          pd[x],      dtmp[x]
        sub     lerpP,      cpos,       ppos
        mul     lerpP,      lerpP,      q
        add     lerpP,      lerpP,      ppos
        sub     lerpT,      cstq,       pstq
        mul     lerpT,      lerpT,      q
        add     lerpT,      lerpT,      pstq
        sub     lerpC,      ccol,       pcol
        mul     lerpC,      lerpC,      q
        add     lerpC,      lerpC,      pcol
        sq      lerpP,      0(dstPtr)
        sq      lerpT,      1(dstPtr)
        sq      lerpC,      2(dstPtr)
        iaddiu  dstPtr,     dstPtr,     3
        ; when cur is inside too, it is emitted as well
        ibne    VI01,       vi00,       edgeAdvance     ; cur outside
edgeEmitCur:
        sq      cpos,       0(dstPtr)
        sq      cstq,       1(dstPtr)
        sq      ccol,       2(dstPtr)
        iaddiu  dstPtr,     dstPtr,     3
edgeAdvance:
        move    ppos,       cpos
        move    pstq,       cstq
        move    pcol,       ccol
        add.x   pd,         vf00,       cd[x]
        iaddiu  curPtr,     curPtr,     3
        ibne    curPtr,     srcEnd,     edgeLoop

        ; polygon fully clipped away?
        ibeq    dstPtr,     dstBase,    triNext
        ; swap src <-> dst for the next plane
        iadd    srcEnd,     dstPtr,     vi00
        iadd    vertMask,   srcBase,    vi00
        iadd    srcBase,    dstBase,    vi00
        iadd    dstBase,    vertMask,   vi00
        iaddiu  planePtr,   planePtr,   2
        iaddiu  vertMask,   vi00,       VU1_CLIP_PLANES_ADDR+12
        ibne    planePtr,   vertMask,   planeLoop

fanStart:
        ; fewer than 3 verts left -> nothing to draw
        iaddiu  vertMask,   srcBase,    9
        isub    vertMask,   srcEnd,     vertMask
        ibltz   vertMask,   triNext

        ; fan-triangulate: (P0, Pj, Pj+1) for j = 1 .. n-2
        iaddiu  fanPtr,     srcBase,    3
fanLoop:
        iaddiu  fanNext,    fanPtr,     3
        ibeq    fanNext,    srcEnd,     triNext

        EmitClipVertexTD{ srcBase, destAddress, scale, fogParams }
        EmitClipVertexTD{ fanPtr,  destAddress, scale, fogParams }
        EmitClipVertexTD{ fanNext, destAddress, scale, fogParams }
        iaddiu  outCount,   outCount,   3

        iadd    fanPtr,     fanNext,    vi00
        b       fanLoop

triNext:
        iaddiu  vertexData,     vertexData,     3
        iaddiu  stqData,        stqData,        3
        iaddiu  normalData,     normalData,     3
        iaddi   vertexCounter,  vertexCounter,  -3
        ibgtz   vertexCounter,  triLoop

    ; rebuild the kick address and patch the prim giftag NLOOP (the
    ; texture tag block is 7 qwords; the prim tag sits at +6)
    xtop    buffer
    iaddiu  vertexData, buffer,     VU1_STAPIP_VERT_DATA_ADDR
    ilw.w   vertexCount, 0(buffer)
    iadd    vertexData, vertexData, vertexCount
    iadd    vertexData, vertexData, vertexCount
    iadd    vertexData, vertexData, vertexCount
    iaddiu  vertMask,   outCount,   0x4000
    iaddiu  vertMask,   vertMask,   0x4000
    isw.x   vertMask,   6(vertexData)

    xgkick vertexData ; dispatch to the GS rasterizer.

--barrier ; Why the hell I must add barrier AFTER XGKICK? VCL does not adds E bit without it...
--cont

    b   begin

#endvuprog

--exit
--endexit
