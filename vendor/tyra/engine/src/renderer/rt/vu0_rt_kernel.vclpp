; _____        ____   ___
;   |     \/   ____| |___|
;   |     |   |   \  |   |
;---------------------------------------------------------------
; Copyright 2022, tyra - https://github.com/h4570/tyra
; Licensed under Apache License 2.0
; Added by TyraX: VU0 MICROMODE ray tracing kernel (raytraced
; mirror reflections - see inc/renderer/rt/vu0_raytracer.hpp).
;
;---------------------------------------------------------------
; Traces ONE row of reflection-image texels per vcallms. The EE
; reflects the camera across the mirror plane once per frame, so
; each texel's reflected ray is simply normalize(P - mirroredEye)
; - no per-texel reflection math. Rays intersect sphere proxies,
; axis-aligned slab proxies (flat objects) and up to two TRIANGLE
; MESH groups (decimated model proxies, Moller-Trumbore); misses
; shade from a vertical sky gradient.
;
; VU0-honest: no XGKICK, no EFU (esum/ersqrt are VU1-only), no
; xtop - fixed VU0 data-mem addresses only. Hit selection is
; BRANCHLESS: VU floats saturate instead of producing inf/nan,
; so clamp(x * 1e38, 0, 1) is an exact step(0, x) for any
; geometrically meaningful x - masks select the nearest hit. The
; only branches are loop back-edges and two early-outs (sphere
; count, per-group bounding-sphere miss).
;
; NO sentinel-BIG mixing anywhere: mix(BIG, t, m) computes
; (t - BIG) + BIG, and in single floats t - 1e10 rounds to exactly
; -1e10 - the real t is annihilated and every selected distance
; degenerates to 0 (cost a debugging round). Nearest-hit state is
; (t, hitFlag) pairs folded with comparison masks; the triangle
; loop compares rational t (numerator/denominator) by
; cross-multiplication and divides only once, for the winner.
;
; VU0 CANNOT SAMPLE TEXTURES - a triangle hit is returned as
; (record address, u*4096, v*4096, shade*255) and the EE samples
; the model's texture in RAM while packing the row. Direct-color
; texels (sphere/slab/sky) carry w = -256.
;
; Data memory layout (qword addresses, EE writes via 0x11004000):
;   0  eye.xyz      = camera REFLECTED across the mirror plane
;   1  rowBase.xyz  = world position of this row's first texel
;   2  du.xyz       = world step per texel along the row
;   3  light.xyz    = normalized dir TOWARD the light
;   4  skyTop.rgb   = zenith color 0..255
;   5  skyBot.rgb   = horizon color 0..255
;   6  ints: x=sphereCount y=texelCount z=slabCount w=groupCount
;   7  consts2: x=0.30 (ambient) y=0.70 (diffuse) z=0.5 w=1e38
;   8  consts:  x=eps (0.01) y=epsDet (1e-8) z=255 w=4096
;   9  group0 bounding sphere (cx,cy,cz, r^2)
;   10 group1 bounding sphere
;   11 intsG: x=start0 y=count0 z=start1 w=count1 (start = the
;      group's first triangle record qword address)
;   12..19 sphere centers (xyz, w = radius^2)
;   20..27 sphere colors  (rgb 0..255)
;   28..31 slab mins (xyz), 32..35 slab maxs, 36..39 slab colors
;   40..103 output row (max 64 texels), see above
;   104..247 triangle records, 4 qwords each (max 36):
;      +0 v0.xyz   +1 N.xyz (e1 x e2, unnormalized - t and the shade
;      normal)   +2 A.xyz   +3 B.xyz (the dual basis: u = (H-v0).A,
;      v = (H-v0).B). Texture UVs never enter VU0 - the hit returns
;      BARYCENTRIC u/v and the EE interpolates the texture coordinates
;      from its own copy of the records while packing.
;---------------------------------------------------------------

.syntax new
.name Vu0RtKernel
.vu
.init_vf_all
.init_vi_all

--enter
--endenter

#vuprog Vu0RtKernel

    lq      pos,        1(vi00)
    lq      cq2,        7(vi00)
    lq      cq,         8(vi00)
    ilw.x   sphCount,   6(vi00)
    ilw.y   texCount,   6(vi00)
    ilw.z   slabCount,  6(vi00)
    ilw.w   grpCount,   6(vi00)
    iaddiu  outAddr,    vi00,       40
    ; oneV.xyz = 1.0 - the fs-side "1" the mask inversions need (broadcast
    ; fields are only legal on the ft operand, so vf00[w] can't sit first);
    ; negOne.xyz = -1.0 clamps ray-signs; fourV.x = 4.0 steps the triangle
    ; record address accumulator
    add.xyz oneV,       vf00,       vf00[w]
    sub.xyz negOne,     vf00,       oneV
    add.x   fourV,      oneV,       oneV[x]
    add.x   fourV,      fourV,      fourV[x]

texelLoop:
    ;--- unit ray dir R = normalize(P - mirroredEye). Fixed-address params
    ; (eye/du/sky/light) reload at their use sites instead of living in
    ; registers - the triangle loop peaks near the 31-VF ceiling and VCL
    ; dies with "no opt table" when allocation fails.
    lq          eye,    0(vi00)
    sub.xyz     d,      pos,        eye
    mul.xyz     t0,     d,          d
    add.x       t0,     t0,         t0[y]
    add.x       t0,     t0,         t0[z]
    rsqrt       q,      vf00[w],    t0[x]
    mulq.xyz    rd,     d,          q

    ;--- nearest-sphere state: bT=0 + bHit=0 ("no hit yet"), center/color
    ; zeroed (self-sub is a true zero even over saturated garbage; a fully
    ; selected mix (m=1.0 exactly) then reproduces the folded values with
    ; no cancellation error)
    sub.x       bT,     bT,         bT
    sub.x       bHit,   bHit,       bHit
    sub.xyzw    bC,     bC,         bC
    sub.xyz     bCol,   bCol,       bCol

    iadd        si,     vi00,       sphCount
    iaddiu      cAddr,  vi00,       12
    iaddiu      colAddr, vi00,      20
    ibeq        si,     vi00,       sphDone

sphLoop:
    lq          c,      0(cAddr)
    lq          scol,   0(colAddr)
    sub.xyz     oc,     c,          pos
    ; b = oc . R
    mul.xyz     t1,     oc,         rd
    add.x       t1,     t1,         t1[y]
    add.x       t1,     t1,         t1[z]
    ; oc2 = oc . oc
    mul.xyz     t2,     oc,         oc
    add.x       t2,     t2,         t2[y]
    add.x       t2,     t2,         t2[z]
    ; disc = b^2 - oc2 + radius^2
    mul.x       t3,     t1,         t1[x]
    sub.x       t3,     t3,         t2[x]
    add.x       t3,     t3,         c[w]
    ; sqrt of clamped disc (junk when disc<0 - masked out below)
    max.x       t4,     t3,         vf00[x]
    sqrt        q,      t4[x]
    ; m0 = step(0, disc)
    mul.x       m0,     t3,         cq2[w]
    max.x       m0,     m0,         vf00[x]
    mini.x      m0,     m0,         vf00[w]
    ; t = b - sqrt(disc); m0 &= step(eps, t)
    subq.x      t5,     t1,         q
    sub.x       t6,     t5,         cq[x]
    mul.x       t6,     t6,         cq2[w]
    max.x       t6,     t6,         vf00[x]
    mini.x      t6,     t6,         vf00[w]
    mul.x       m0,     m0,         t6
    ; m2 = m0 AND (first hit OR t < bT), compared at real-distance scale
    sub.x       nh,     oneV,       bHit[x]
    sub.x       cl,     bT,         t5[x]
    mul.x       cl,     cl,         cq2[w]
    max.x       cl,     cl,         vf00[x]
    mini.x      cl,     cl,         vf00[w]
    max.x       m2,     nh,         cl[x]
    mul.x       m2,     m2,         m0[x]
    ; fold into best state
    sub.x       t8,     t5,         bT
    mul.x       t8,     t8,         m2[x]
    add.x       bT,     bT,         t8
    sub.xyzw    t9,     c,          bC
    mul.xyzw    t9,     t9,         m2[x]
    add.xyzw    bC,     bC,         t9
    sub.xyz     tA,     scol,       bCol
    mul.xyz     tA,     tA,         m2[x]
    add.xyz     bCol,   bCol,       tA
    max.x       bHit,   bHit,       m0

    iaddiu      cAddr,  cAddr,      1
    iaddiu      colAddr, colAddr,   1
    iaddi       si,     si,         -1
    ibgtz       si,     sphLoop

sphDone:
    ;--- sphere lambert: N = normalize(hit - center), 0.30 + 0.70*max(N.L,0)
    mul.xyz     h,      rd,         bT[x]
    add.xyz     h,      h,          pos
    sub.xyz     n1,     h,          bC
    mul.xyz     t0,     n1,         n1
    add.x       t0,     t0,         t0[y]
    add.x       t0,     t0,         t0[z]
    ; degenerate-safe: no hit leaves n1 = junk, masked out at compose
    max.x       t0,     t0,         cq[x]
    rsqrt       q,      vf00[w],    t0[x]
    mulq.xyz    n1,     n1,         q
    lq          ldir,   3(vi00)
    mul.xyz     t1,     n1,         ldir
    add.x       t1,     t1,         t1[y]
    add.x       t1,     t1,         t1[z]
    max.x       t1,     t1,         vf00[x]
    mul.x       t1,     t1,         cq2[y]
    add.x       t1,     t1,         cq2[x]
    mul.xyz     sphCol, bCol,       t1[x]

    ;--- AABB slab proxies (flat objects): nearest slab hit, branchless.
    ; State zeroed even when no slabs were sent - the merge below mixes
    ; with mask 0 and VCL's path analysis stays happy.
    sub.x       bTb,    bTb,        bTb
    sub.x       bHb,    bHb,        bHb
    sub.xyz     bN3,    bN3,        bN3
    sub.xyz     bColB,  bColB,      bColB
    sub.xyz     boxCol, boxCol,     boxCol
    ibeq        slabCount, vi00,    boxDone
    ; per-texel inverse ray (a zero component saturates - the slab
    ; min/max folds absorb the huge values)
    div         q,      vf00[w],    rd[x]
    addq.x      ivd,    vf00,       q
    div         q,      vf00[w],    rd[y]
    addq.y      ivd,    vf00,       q
    div         q,      vf00[w],    rd[z]
    addq.z      ivd,    vf00,       q
    iadd        bi,     vi00,       slabCount
    iaddiu      bAddr,  vi00,       28
    iaddiu      bmAddr, vi00,       32
    iaddiu      bcAddr, vi00,       36
boxLoop:
    lq          bmn,    0(bAddr)
    lq          bmx,    0(bmAddr)
    lq          bcl,    0(bcAddr)
    sub.xyz     ta,     bmn,        pos
    mul.xyz     ta,     ta,         ivd
    sub.xyz     tb,     bmx,        pos
    mul.xyz     tb,     tb,         ivd
    mini.xyz    tn3,    ta,         tb
    max.xyz     tf3,    ta,         tb
    max.x       tn,     tn3,        tn3[y]
    max.x       tn,     tn,         tn3[z]
    mini.x      tf,     tf3,        tf3[y]
    mini.x      tf,     tf,         tf3[z]
    ; m0 = step(eps, tn) * step(0, tf - tn)
    sub.x       m0,     tn,         cq[x]
    mul.x       m0,     m0,         cq2[w]
    max.x       m0,     m0,         vf00[x]
    mini.x      m0,     m0,         vf00[w]
    sub.x       t6,     tf,         tn[x]
    mul.x       t6,     t6,         cq2[w]
    max.x       t6,     t6,         vf00[x]
    mini.x      t6,     t6,         vf00[w]
    mul.x       m0,     m0,         t6
    ; m2 = m0 AND (first slab hit OR tn < bTb)
    sub.x       nh,     oneV,       bHb[x]
    sub.x       cl,     bTb,        tn[x]
    mul.x       cl,     cl,         cq2[w]
    max.x       cl,     cl,         vf00[x]
    mini.x      cl,     cl,         vf00[w]
    max.x       m2,     nh,         cl[x]
    mul.x       m2,     m2,         m0[x]
    ; fold best: entry t, per-axis entry times (the normal source), color
    sub.x       t8,     tn,         bTb
    mul.x       t8,     t8,         m2[x]
    add.x       bTb,    bTb,        t8
    sub.xyz     t9,     tn3,        bN3
    mul.xyz     t9,     t9,         m2[x]
    add.xyz     bN3,    bN3,        t9
    sub.xyz     tA,     bcl,        bColB
    mul.xyz     tA,     tA,         m2[x]
    add.xyz     bColB,  bColB,      tA
    max.x       bHb,    bHb,        m0
    iaddiu      bAddr,  bAddr,      1
    iaddiu      bmAddr, bmAddr,     1
    iaddiu      bcAddr, bcAddr,     1
    iaddi       bi,     bi,         -1
    ibgtz       bi,     boxLoop

    ;--- winning slab's face normal: the axis whose entry time equals the
    ; folded tn (vector masks), signed against the ray direction
    add.xyz     tB,     vf00,       bTb[x]
    sub.xyz     d3,     tB,         bN3
    mul.xyz     d3,     d3,         cq2[w]
    max.xyz     d3,     d3,         vf00[x]
    mini.xyz    d3,     d3,         vf00[w]
    sub.xyz     axm,    oneV,       d3
    mul.xyz     sgn,    rd,         cq2[w]
    mini.xyz    sgn,    sgn,        vf00[w]
    max.xyz     sgn,    sgn,        negOne
    mul.xyz     nB,     sgn,        axm
    sub.xyz     nB,     vf00,       nB
    ; slab lambert, same terms as the spheres
    lq          ldir,   3(vi00)
    mul.xyz     t1,     nB,         ldir
    add.x       t1,     t1,         t1[y]
    add.x       t1,     t1,         t1[z]
    max.x       t1,     t1,         vf00[x]
    mul.x       t1,     t1,         cq2[y]
    add.x       t1,     t1,         cq2[x]
    mul.xyz     boxCol, bColB,      t1[x]

boxDone:
    ;--- merge spheres + slabs into one nearest direct-color scene hit
    sub.x       nh,     oneV,       bHit[x]
    sub.x       cl,     bT,         bTb[x]
    mul.x       cl,     cl,         cq2[w]
    max.x       cl,     cl,         vf00[x]
    mini.x      cl,     cl,         vf00[w]
    max.x       useB,   nh,         cl[x]
    mul.x       useB,   useB,       bHb[x]
    sub.x       t8,     bTb,        bT
    mul.x       t8,     t8,         useB[x]
    add.x       bT,     bT,         t8
    sub.xyz     t9,     boxCol,     sphCol
    mul.xyz     t9,     t9,         useB[x]
    add.xyz     hitCol, sphCol,     t9
    max.x       bHit,   bHit,       bHb

    ;--- triangle groups (decimated model proxies, Moller-Trumbore).
    ; Rational nearest fold: t is compared as numerator/denominator by
    ; cross-multiplication (denominators are |det| >= 0), one division at
    ; the end for the winner only. bDA.y folds the winning record's qword
    ; address as a float (exact - addresses are < 256).
    sub.xyz     bNum,   bNum,       bNum
    sub.xy      bDA,    bDA,        bDA
    sub.x       bHt,    bHt,        bHt
    sub.x       triShd, triShd,     triShd
    sub.x       triT,   triT,       triT
    sub.x       triU,   triU,       triU
    sub.x       triV,   triV,       triV
    ibeq        grpCount, vi00,     triDone

    ; groups are UNROLLED (VCL's optimizer failed to build its table
    ; for the nested group/triangle loop CFG - "no opt table for
    ; triLoop"; two flat blocks with one back-edge each assemble fine).
    ; Per group: bounding-sphere early-out - hit if disc >= 0 AND the
    ; EXIT distance b + sqrt(disc) >= 0, true also with the ray origin
    ; inside (the slab lesson: entry-distance tests kill inside rays).
    lq          gb,     9(vi00)
    sub.xyz     oc,     gb,         pos
    mul.xyz     t1,     oc,         rd
    add.x       t1,     t1,         t1[y]
    add.x       t1,     t1,         t1[z]
    mul.xyz     t2,     oc,         oc
    add.x       t2,     t2,         t2[y]
    add.x       t2,     t2,         t2[z]
    mul.x       t3,     t1,         t1[x]
    sub.x       t3,     t3,         t2[x]
    add.x       t3,     t3,         gb[w]
    max.x       t4,     t3,         vf00[x]
    sqrt        q,      t4[x]
    mul.x       m0,     t3,         cq2[w]
    max.x       m0,     m0,         vf00[x]
    mini.x      m0,     m0,         vf00[w]
    addq.x      t5,     t1,         q
    mul.x       t6,     t5,         cq2[w]
    max.x       t6,     t6,         vf00[x]
    mini.x      t6,     t6,         vf00[w]
    mul.x       m0,     m0,         t6
    ftoi0.x     mi0,    m0
    mtir        gTest,  mi0[x]
    ibeq        gTest,  vi00,       grp1Check
    ilw.x       tAddr,  11(vi00)
    ilw.y       tCount, 11(vi00)
    ibeq        tCount, vi00,       grp1Check
    mfir.x      adrI,   tAddr
    itof0.x     adrF,   adrI

triLoop0:
    lq          tv0,    0(tAddr)
    lq          tnq,    1(tAddr)
    lq          tAq,    2(tAddr)
    lq          tBq,    3(tAddr)
    ; dP = v0 - P ; t = (dP.N)/(rd.N), kept rational
    sub.xyz     dP,     tv0,        pos
    mul.xyz     t1,     dP,         tnq
    add.x       t1,     t1,         t1[y]
    add.x       t1,     t1,         t1[z]
    mul.xyz     t2,     rd,         tnq
    add.x       t2,     t2,         t2[y]
    add.x       t2,     t2,         t2[z]
    ; fold double-sided: sg = sign(rd.N), aD = |rd.N|, tNs = (dP.N)*sg
    mul.x       sgD,    t2,         cq2[w]
    mini.x      sgD,    sgD,        vf00[w]
    max.x       sgD,    sgD,        negOne
    mul.x       dd,     t2,         sgD[x]
    mul.x       tts,    t1,         sgD[x]
    ; barycentrics via the precomputed dual basis (u = (H-v0).A):
    ; u * (rd.N) = (dP.N)*(rd.A) - (dP.A)*(rd.N), same for B
    mul.xyz     t3,     rd,         tAq
    add.x       t3,     t3,         t3[y]
    add.x       t3,     t3,         t3[z]
    mul.xyz     t4,     dP,         tAq
    add.x       t4,     t4,         t4[y]
    add.x       t4,     t4,         t4[z]
    mul.x       t7,     t1,         t3[x]
    mul.x       t8,     t4,         t2[x]
    sub.x       uu,     t7,         t8[x]
    mul.x       uu,     uu,         sgD[x]
    mul.xyz     t3,     rd,         tBq
    add.x       t3,     t3,         t3[y]
    add.x       t3,     t3,         t3[z]
    mul.xyz     t4,     dP,         tBq
    add.x       t4,     t4,         t4[y]
    add.x       t4,     t4,         t4[z]
    mul.x       t7,     t1,         t3[x]
    mul.x       t8,     t4,         t2[x]
    sub.x       vv,     t7,         t8[x]
    mul.x       vv,     vv,         sgD[x]
    ; valid = (aD > epsDet) & (t >= eps) & (u >= 0) & (v >= 0)
    ;         & (u + v <= 1), all scaled by aD (rational)
    sub.x       m0,     dd,         cq[y]
    mul.x       m0,     m0,         cq2[w]
    max.x       m0,     m0,         vf00[x]
    mini.x      m0,     m0,         vf00[w]
    mul.x       t7,     dd,         cq[x]
    sub.x       t7,     tts,        t7[x]
    mul.x       t7,     t7,         cq2[w]
    max.x       t7,     t7,         vf00[x]
    mini.x      t7,     t7,         vf00[w]
    mul.x       m0,     m0,         t7
    mul.x       t6,     uu,         cq2[w]
    max.x       t6,     t6,         vf00[x]
    mini.x      t6,     t6,         vf00[w]
    mul.x       m0,     m0,         t6
    mul.x       t6,     vv,         cq2[w]
    max.x       t6,     t6,         vf00[x]
    mini.x      t6,     t6,         vf00[w]
    mul.x       m0,     m0,         t6
    sub.x       t7,     dd,         uu[x]
    sub.x       t7,     t7,         vv[x]
    mul.x       t7,     t7,         cq2[w]
    max.x       t7,     t7,         vf00[x]
    mini.x      t7,     t7,         vf00[w]
    mul.x       m0,     m0,         t7
    ; rational nearest: new wins if tts * den < tNum * dd (dens >= 0)
    mul.x       t7,     bNum,       dd[x]
    mul.x       t8,     tts,        bDA[x]
    sub.x       cl,     t7,         t8[x]
    mul.x       cl,     cl,         cq2[w]
    max.x       cl,     cl,         vf00[x]
    mini.x      cl,     cl,         vf00[w]
    sub.x       nh,     oneV,       bHt[x]
    max.x       m2,     nh,         cl[x]
    mul.x       m2,     m2,         m0[x]
    ; fold the packed best state: bNum = (t,u,v), bDA = (den, address)
    add.x       cnd,    vf00,       tts[x]
    add.y       cnd,    vf00,       uu[x]
    add.z       cnd,    vf00,       vv[x]
    add.x       cda,    vf00,       dd[x]
    add.y       cda,    vf00,       adrF[x]
    sub.xyz     t8,     cnd,        bNum
    mul.xyz     t8,     t8,         m2[x]
    add.xyz     bNum,   bNum,       t8
    sub.xy      t8,     cda,        bDA
    mul.xy      t8,     t8,         m2[x]
    add.xy      bDA,    bDA,        t8
    max.x       bHt,    bHt,        m0
    add.x       adrF,   adrF,       fourV[x]
    iaddiu      tAddr,  tAddr,      4
    iaddi       tCount, tCount,     -1
    ibgtz       tCount, triLoop0

grp1Check:
    iaddi       gTest,  grpCount,   -1
    ibeq        gTest,  vi00,       triResolve
    lq          gb,     10(vi00)
    sub.xyz     oc,     gb,         pos
    mul.xyz     t1,     oc,         rd
    add.x       t1,     t1,         t1[y]
    add.x       t1,     t1,         t1[z]
    mul.xyz     t2,     oc,         oc
    add.x       t2,     t2,         t2[y]
    add.x       t2,     t2,         t2[z]
    mul.x       t3,     t1,         t1[x]
    sub.x       t3,     t3,         t2[x]
    add.x       t3,     t3,         gb[w]
    max.x       t4,     t3,         vf00[x]
    sqrt        q,      t4[x]
    mul.x       m0,     t3,         cq2[w]
    max.x       m0,     m0,         vf00[x]
    mini.x      m0,     m0,         vf00[w]
    addq.x      t5,     t1,         q
    mul.x       t6,     t5,         cq2[w]
    max.x       t6,     t6,         vf00[x]
    mini.x      t6,     t6,         vf00[w]
    mul.x       m0,     m0,         t6
    ftoi0.x     mi0,    m0
    mtir        gTest,  mi0[x]
    ibeq        gTest,  vi00,       triResolve
    ilw.z       tAddr,  11(vi00)
    ilw.w       tCount, 11(vi00)
    ibeq        tCount, vi00,       triResolve
    mfir.x      adrI,   tAddr
    itof0.x     adrF,   adrI

triLoop1:
    lq          tv0,    0(tAddr)
    lq          tnq,    1(tAddr)
    lq          tAq,    2(tAddr)
    lq          tBq,    3(tAddr)
    ; dP = v0 - P ; t = (dP.N)/(rd.N), kept rational
    sub.xyz     dP,     tv0,        pos
    mul.xyz     t1,     dP,         tnq
    add.x       t1,     t1,         t1[y]
    add.x       t1,     t1,         t1[z]
    mul.xyz     t2,     rd,         tnq
    add.x       t2,     t2,         t2[y]
    add.x       t2,     t2,         t2[z]
    ; fold double-sided: sg = sign(rd.N), aD = |rd.N|, tNs = (dP.N)*sg
    mul.x       sgD,    t2,         cq2[w]
    mini.x      sgD,    sgD,        vf00[w]
    max.x       sgD,    sgD,        negOne
    mul.x       dd,     t2,         sgD[x]
    mul.x       tts,    t1,         sgD[x]
    ; barycentrics via the precomputed dual basis (u = (H-v0).A):
    ; u * (rd.N) = (dP.N)*(rd.A) - (dP.A)*(rd.N), same for B
    mul.xyz     t3,     rd,         tAq
    add.x       t3,     t3,         t3[y]
    add.x       t3,     t3,         t3[z]
    mul.xyz     t4,     dP,         tAq
    add.x       t4,     t4,         t4[y]
    add.x       t4,     t4,         t4[z]
    mul.x       t7,     t1,         t3[x]
    mul.x       t8,     t4,         t2[x]
    sub.x       uu,     t7,         t8[x]
    mul.x       uu,     uu,         sgD[x]
    mul.xyz     t3,     rd,         tBq
    add.x       t3,     t3,         t3[y]
    add.x       t3,     t3,         t3[z]
    mul.xyz     t4,     dP,         tBq
    add.x       t4,     t4,         t4[y]
    add.x       t4,     t4,         t4[z]
    mul.x       t7,     t1,         t3[x]
    mul.x       t8,     t4,         t2[x]
    sub.x       vv,     t7,         t8[x]
    mul.x       vv,     vv,         sgD[x]
    ; valid = (aD > epsDet) & (t >= eps) & (u >= 0) & (v >= 0)
    ;         & (u + v <= 1), all scaled by aD (rational)
    sub.x       m0,     dd,         cq[y]
    mul.x       m0,     m0,         cq2[w]
    max.x       m0,     m0,         vf00[x]
    mini.x      m0,     m0,         vf00[w]
    mul.x       t7,     dd,         cq[x]
    sub.x       t7,     tts,        t7[x]
    mul.x       t7,     t7,         cq2[w]
    max.x       t7,     t7,         vf00[x]
    mini.x      t7,     t7,         vf00[w]
    mul.x       m0,     m0,         t7
    mul.x       t6,     uu,         cq2[w]
    max.x       t6,     t6,         vf00[x]
    mini.x      t6,     t6,         vf00[w]
    mul.x       m0,     m0,         t6
    mul.x       t6,     vv,         cq2[w]
    max.x       t6,     t6,         vf00[x]
    mini.x      t6,     t6,         vf00[w]
    mul.x       m0,     m0,         t6
    sub.x       t7,     dd,         uu[x]
    sub.x       t7,     t7,         vv[x]
    mul.x       t7,     t7,         cq2[w]
    max.x       t7,     t7,         vf00[x]
    mini.x      t7,     t7,         vf00[w]
    mul.x       m0,     m0,         t7
    ; rational nearest: new wins if tts * den < tNum * dd (dens >= 0)
    mul.x       t7,     bNum,       dd[x]
    mul.x       t8,     tts,        bDA[x]
    sub.x       cl,     t7,         t8[x]
    mul.x       cl,     cl,         cq2[w]
    max.x       cl,     cl,         vf00[x]
    mini.x      cl,     cl,         vf00[w]
    sub.x       nh,     oneV,       bHt[x]
    max.x       m2,     nh,         cl[x]
    mul.x       m2,     m2,         m0[x]
    ; fold the packed best state: bNum = (t,u,v), bDA = (den, address)
    add.x       cnd,    vf00,       tts[x]
    add.y       cnd,    vf00,       uu[x]
    add.z       cnd,    vf00,       vv[x]
    add.x       cda,    vf00,       dd[x]
    add.y       cda,    vf00,       adrF[x]
    sub.xyz     t8,     cnd,        bNum
    mul.xyz     t8,     t8,         m2[x]
    add.xyz     bNum,   bNum,       t8
    sub.xy      t8,     cda,        bDA
    mul.xy      t8,     t8,         m2[x]
    add.xy      bDA,    bDA,        t8
    max.x       bHt,    bHt,        m0
    add.x       adrF,   adrF,       fourV[x]
    iaddiu      tAddr,  tAddr,      4
    iaddi       tCount, tCount,     -1
    ibgtz       tCount, triLoop1

triResolve:

    ; resolve the winner: real t/u/v (three serial Q divisions - only on
    ; texels whose group bound was hit), then the record's UV rows and
    ; face normal for the shade
    ftoi0.x     mi0,    bHt
    mtir        gTest,  mi0[x]
    ibeq        gTest,  vi00,       triDone
    div         q,      bNum[x],    bDA[x]
    addq.x      triT,   vf00,       q
    div         q,      bNum[y],    bDA[x]
    addq.x      triU,   vf00,       q
    div         q,      bNum[z],    bDA[x]
    addq.x      triV,   vf00,       q
    add.x       t8,     vf00,       bDA[y]
    ftoi0.x     adrI,   t8
    mtir        tAddr,  adrI[x]
    ; face normal = normalize(stored N), flipped toward the ray
    lq          nT,     1(tAddr)
    mul.xyz     t0,     nT,         nT
    add.x       t0,     t0,         t0[y]
    add.x       t0,     t0,         t0[z]
    max.x       t0,     t0,         cq[y]
    rsqrt       q,      vf00[w],    t0[x]
    mulq.xyz    nT,     nT,         q
    mul.xyz     t1,     nT,         rd
    add.x       t1,     t1,         t1[y]
    add.x       t1,     t1,         t1[z]
    mul.x       t1,     t1,         cq2[w]
    mini.x      t1,     t1,         vf00[w]
    max.x       t1,     t1,         negOne
    mul.xyz     nT,     nT,         t1[x]
    sub.xyz     nT,     vf00,       nT
    lq          ldir,   3(vi00)
    mul.xyz     t1,     nT,         ldir
    add.x       t1,     t1,         t1[y]
    add.x       t1,     t1,         t1[z]
    max.x       t1,     t1,         vf00[x]
    mul.x       t1,     t1,         cq2[y]
    add.x       t1,     t1,         cq2[x]
    mul.x       triShd, t1,         cq[z]

triDone:
    ;--- sky gradient from the ray's upward component (broadcast fields
    ; are only legal on the SECOND source operand, hence the vf00 first)
    max.x       sm,     vf00,       rd[y]
    mini.x      sm,     sm,         vf00[w]
    lq          skyTop, 4(vi00)
    lq          skyBot, 5(vi00)
    sub.xyz     sc,     skyTop,     skyBot
    mul.xyz     sc,     sc,         sm[x]
    add.xyz     sc,     sc,         skyBot

    ;--- compose. Direct-color path first: sky under the sphere/slab hit.
    sub.xyz     t3,     hitCol,     sc
    mul.xyz     t3,     t3,         bHit[x]
    add.xyz     colf,   sc,         t3
    max.xyz     colf,   colf,       vf00[x]
    mini.xyz    colf,   colf,       cq[z]
    ; triangle wins when it hit AND (no direct hit OR the triangle is
    ; closer at real-distance scale)
    sub.x       cl,     bT,         triT[x]
    mul.x       cl,     cl,         cq2[w]
    max.x       cl,     cl,         vf00[x]
    mini.x      cl,     cl,         vf00[w]
    sub.x       nh,     oneV,       bHit[x]
    max.x       mT,     nh,         cl[x]
    mul.x       mT,     mT,         bHt[x]
    ; triangle payload: x = record address, y/z = u/v * 4096, w = shade
    mul.x       triU,   triU,       cq[w]
    mul.x       triV,   triV,       cq[w]
    add.x       pay,    vf00,       bDA[y]
    add.y       pay,    vf00,       triU[x]
    add.z       pay,    vf00,       triV[x]
    ; out.xyz = mix(direct rgb, payload, mT); out.w = mix(-256, shade, mT)
    sub.xyz     t5,     pay,        colf
    mul.xyz     t5,     t5,         mT[x]
    add.xyz     colf,   colf,       t5
    sub.x       wv,     vf00,       cq[z]
    sub.x       wv,     wv,         oneV[x]
    sub.x       t8,     triShd,     wv
    mul.x       t8,     t8,         mT[x]
    add.x       wv,     wv,         t8
    ; vf00.w = 1, so the .w lane is written by MULTIPLYING it (add would
    ; be off by one)
    mul.w       colf,   vf00,       wv[x]
    ftoi0.xyzw  oc0,    colf
    sq          oc0,    0(outAddr)

    lq          du,     2(vi00)
    add.xyz     pos,    pos,        du
    iaddiu      outAddr, outAddr,   1
    iaddi       texCount, texCount, -1
    ibgtz       texCount, texelLoop

#endvuprog

--exit
--endexit
